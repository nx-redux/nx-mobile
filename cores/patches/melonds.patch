+bool IsGLES()
+{
+    static const bool gles = []
+    {
+        const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+        return version && strncmp(version, "OpenGL ES", 9) == 0;
+    }();
+    return gles;
+}
+
+GLenum Type1555()
+{
+    return IsGLES() ? GL_UNSIGNED_SHORT_5_5_5_1 : GL_UNSIGNED_SHORT_1_5_5_5_REV;
+}
+
+const void* Upload1555(const void* src, u32 count)
+{
+    if (!IsGLES()) return src;
+    static std::vector<u16> buffer;
+    if (buffer.size() < count) buffer.resize(count);
+    const u16* in = static_cast<const u16*>(src);
+    for (u32 i = 0; i < count; i++)
+    {
+        u16 v = in[i];
+        buffer[i] = ((v & 0x1F) << 11) | (((v >> 5) & 0x1F) << 6) | (((v >> 10) & 0x1F) << 1) | (v >> 15);
+    }
+    return buffer.data();
+}
+
+void ReadPixels1555(GLint x, GLint y, GLsizei width, GLsizei height, void* dst)
+{
+    if (!IsGLES())
+    {
+        glReadPixels(x, y, width, height, GL_RGBA, GL_UNSIGNED_SHORT_1_5_5_5_REV, dst);
+        return;
+    }
+    static std::vector<u8> buffer;
+    u32 count = width * height;
+    if (buffer.size() < count * 4) buffer.resize(count * 4);
+    glReadPixels(x, y, width, height, GL_RGBA, GL_UNSIGNED_BYTE, buffer.data());
+    u16* out = static_cast<u16*>(dst);
+    for (u32 i = 0; i < count; i++)
+    {
+        const u8* p = &buffer[i * 4];
+        out[i] = (p[0] >> 3) | ((p[1] >> 3) << 5) | ((p[2] >> 3) << 10) | ((p[3] >> 7) << 15);
+    }
+}
+
+// The shaders are GLSL 1.40. On GLES they're compiled as GLSL ES 3.20: default precisions, and explicit
+// fragment output locations in place of glBindFragDataLocation, which GLES lacks.
+static std::string ToGLES(const std::string& source, const std::initializer_list<AttributeTarget>* fragmentOutAttrs)
+{
+    static const char* header =
+        "#version 320 es\n"
+        "precision highp float;\n"
+        "precision highp int;\n"
+        "precision highp sampler2D;\n"
+        "precision highp sampler2DArray;\n"
+        "precision highp usampler2D;\n"
+        "precision highp isampler2D;\n"
+        "precision highp usampler2DArray;\n"
+        "precision highp isampler2DArray;\n"
+        "precision highp samplerBuffer;\n"
+        "precision highp usamplerBuffer;\n"
+        "precision highp isamplerBuffer;\n";
+
+    size_t start = source.find("#version");
+    size_t bodyStart = start == std::string::npos ? 0 : source.find('\n', start);
+    std::string body = bodyStart == std::string::npos ? std::string() : source.substr(bodyStart + 1);
+
+    if (fragmentOutAttrs)
+    {
+        static const std::regex out(R"((^|\n)([ \t]*)out[ \t]+(\w+)[ \t]+(\w+)[ \t]*;)");
+        std::string result;
+        auto it = std::sregex_iterator(body.begin(), body.end(), out);
+        size_t last = 0;
+        for (; it != std::sregex_iterator(); ++it)
+        {
+            const std::smatch& m = *it;
+            int location = -1;
+            for (const AttributeTarget& target : *fragmentOutAttrs)
+                if (m[4].str() == target.Name) location = target.Location;
+            result += body.substr(last, m.position(0) - last);
+            result += m[1].str() + m[2].str();
+            if (location >= 0) result += "layout(location = " + std::to_string(location) + ") ";
+            result += "out " + m[3].str() + " " + m[4].str() + ";";
+            last = m.position(0) + m.length(0);
+        }
+        body = result + body.substr(last);
+    }
+
+    return header + body;
+}
