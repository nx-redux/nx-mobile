+// How often a Cemu frame carried only one of the two screens, logged every
+// five seconds while it happens (and once at the start either way), in the
+// layouts that show both. A screen missing from a frame keeps its last
+// picture; this says how often that is what the frontend shows.
+void VulkanRenderer::CountPresentedScreens(bool padView)
+{
+	const uint8 screen = padView ? 2 : 1;
+	const uint32 currentFrame = LatteGPUState.frameCounter;
+	if (currentFrame == m_presentLastFrameCounter)
+	{
+		m_presentFrameScreens |= screen;
+		return;
+	}
+
+	const bool bothShown =
+		g_libretroScreenLayout == LibretroScreenLayout::SideBySide ||
+		g_libretroScreenLayout == LibretroScreenLayout::TopBottom ||
+		g_libretroScreenLayout == LibretroScreenLayout::PictureInPicture ||
+		g_libretroScreenLayout == LibretroScreenLayout::Stacked;
+	auto& stats = m_presentScreenStats;
+	const auto now = std::chrono::steady_clock::now();
+	if (m_presentLastFrameCounter != ~0u && bothShown)
+	{
+		if (stats.frames == 0)
+			stats.windowStart = now;
+		stats.frames++;
+		if (m_presentFrameScreens == 1)
+			stats.tvOnly++;
+		else if (m_presentFrameScreens == 2)
+			stats.gamePadOnly++;
+		if (m_presentFrameGamePadFirst)
+			stats.gamePadFirst++;
+		if (now - stats.windowStart >= std::chrono::seconds(5))
+		{
+			if (!stats.reported || stats.tvOnly || stats.gamePadOnly)
+				cemuLog_log(LogType::Force, "[Vulkan-LR] screens per frame, last {} frames: {} TV only, {} GamePad only, {} GamePad first",
+					stats.frames, stats.tvOnly, stats.gamePadOnly, stats.gamePadFirst);
+			stats = {};
+			stats.reported = true;
+		}
+	}
+	m_presentLastFrameCounter = currentFrame;
+	m_presentFrameScreens = screen;
+	m_presentFrameGamePadFirst = padView;
+}
