diff --git a/src/video_core/cursor_dot.h b/src/video_core/cursor_dot.h
new file mode 100644
index 0000000..bb33f02
--- /dev/null
+++ b/src/video_core/cursor_dot.h
@@ -0,0 +1,41 @@
+// Copyright 2026 NX Redux
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// nx-mobile: the stylus cursor drawn as NX Redux's DS pen dot (a light #D8D8D8 disc in a dark ring) instead of the
+// upstream white crosshair, by every cursor renderer (OpenGL, Vulkan, software).
+
+#pragma once
+
+#include <cmath>
+#include <vector>
+
+namespace CursorDot {
+
+constexpr int kSegments = 24;
+/// The light disc's radius as a share of the dot's: the dark ring is the rest (the DS pen: 14 dp with a 2 dp ring).
+constexpr float kInnerShare = 5.0f / 7.0f;
+constexpr float kInk = 216.0f / 255.0f;
+constexpr int kFloatsPerVertex = 6; // x, y, r, g, b, a
+
+/// Triangles for a dot centred at (cx, cy) with an outer radius of rx by ry, all in the caller's device coordinates:
+/// the ring's disc first, the light disc over it. Each vertex is kFloatsPerVertex floats.
+inline std::vector<float> Vertices(float cx, float cy, float rx, float ry) {
+    std::vector<float> v;
+    v.reserve(2 * kSegments * 3 * kFloatsPerVertex);
+    const auto disc = [&](float sx, float sy, float c, float a) {
+        const auto push = [&](float x, float y) { v.insert(v.end(), {x, y, c, c, c, a}); };
+        for (int i = 0; i < kSegments; ++i) {
+            const float a0 = 6.2831853f * i / kSegments;
+            const float a1 = 6.2831853f * (i + 1) / kSegments;
+            push(cx, cy);
+            push(cx + sx * std::cos(a0), cy + sy * std::sin(a0));
+            push(cx + sx * std::cos(a1), cy + sy * std::sin(a1));
+        }
+    };
+    disc(rx, ry, 0.0f, 0.85f);
+    disc(rx * kInnerShare, ry * kInnerShare, kInk, 0.95f);
+    return v;
+}
+
+} // namespace CursorDot
