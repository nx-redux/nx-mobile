new file mode 100644
index 0000000..e160fc7
--- /dev/null
+++ b/src/citra_libretro/libretro_views.h
@@ -0,0 +1,54 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv3 or any later version
+// Refer to the LICENSE.txt file included.
+
+#pragma once
+
+#include "libretro.h"
+
+// RetroArch's video views API as of libretro/RetroArch#19811, until the vendored libretro.h
+// has it.
+#ifndef RETRO_ENVIRONMENT_SET_VIDEO_VIEWS
+
+#define RETRO_ENVIRONMENT_SET_VIDEO_VIEWS (95 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+#define RETRO_ENVIRONMENT_GET_VIDEO_VIEWS_STATUS (96 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+
+#define RETRO_VIDEO_VIEWS_STATUS_PRESENTS (1 << 0)
+#define RETRO_VIDEO_VIEWS_STATUS_STEREO (1 << 1)
+// A headset is tracking; only set together with PRESENTS and STEREO.
+#define RETRO_VIDEO_VIEWS_STATUS_HMD (1 << 2)
+
+#define RETRO_VIDEO_VIEW_EYE_NONE 0
+#define RETRO_VIDEO_VIEW_EYE_LEFT 1
+#define RETRO_VIDEO_VIEW_EYE_RIGHT 2
+#define RETRO_VIDEO_VIEWS_MAX 8
+// The map's LEFT and RIGHT views were drawn from the frontend's eye poses; Azahar's never are.
+#define RETRO_VIDEO_VIEWS_FLAG_TRACKED (1 << 0)
+
+enum retro_vr_reference_space {
+    RETRO_VR_REFERENCE_SPACE_LOCAL = 0,
+    RETRO_VR_REFERENCE_SPACE_STAGE = 1,
+    RETRO_VR_REFERENCE_SPACE_DUMMY = INT_MAX
+};
+
+struct retro_video_view {
+    unsigned x;
+    unsigned y;
+    unsigned width;
+    unsigned height;
+    unsigned screen;
+    unsigned eye;
+    float aspect_ratio;
+};
+
+struct retro_video_views {
+    const struct retro_video_view* views;
+    unsigned num_views;
+    unsigned flags;
+    enum retro_vr_reference_space reference_space;
+    // Outputs: the frontend writes these back while a headset is tracking.
+    unsigned recommended_view_width;
+    unsigned recommended_view_height;
+};
+
+#endif
diff --git a/src/citra_libretro/video_views.cpp b/src/citra_libretro/video_views.cpp
new file mode 100644
index 0000000..8f831b1
--- /dev/null
+++ b/src/citra_libretro/video_views.cpp
@@ -0,0 +1,90 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv3 or any later version
+// Refer to the LICENSE.txt file included.
+
+#include "citra_libretro/video_views.h"
+#include "core/3ds.h"
+
+namespace LibRetro::VideoViews {
+
+namespace {
+
+Mode current_mode;
+
+retro_video_view MakeView(const Common::Rectangle<u32>& rect, u32 x_offset, unsigned screen,
+                          unsigned eye) {
+    retro_video_view view{};
+    view.x = rect.left + x_offset;
+    view.y = rect.top;
+    view.width = rect.GetWidth();
+    view.height = rect.GetHeight();
+    view.screen = screen;
+    view.eye = eye;
+    view.aspect_ratio = 0.0f;
+    return view;
+}
+
+} // namespace
+
+Mode SelectMode(bool frontend_layout, Settings::LayoutOption own_layout,
+                Settings::StereoRenderOption own_3d, bool swapped, unsigned status,
+                bool renderer_stereo) {
+    const bool presents = (status & RETRO_VIDEO_VIEWS_STATUS_PRESENTS) != 0;
+    const bool stereo = (status & RETRO_VIDEO_VIEWS_STATUS_STEREO) != 0;
+    const bool single = own_layout == Settings::LayoutOption::SingleScreen;
+    // In 2D, views only stand in for Azahar's own layout where they look the same.
+    const bool own_matches = (own_layout == Settings::LayoutOption::Default || single) &&
+                             own_3d == Settings::StereoRenderOption::Off;
+    Mode mode;
+    mode.active = frontend_layout && presents && (stereo || own_matches);
+    mode.single = mode.active && single;
+    // Only the top screen has 3D, so the bottom screen alone is drawn once.
+    const bool top_shown = !(mode.single && swapped);
+    mode.stereo = mode.active && renderer_stereo && stereo && top_shown;
+    return mode;
+}
+
+const Mode& CurrentMode() {
+    return current_mode;
+}
+
+void SetCurrentMode(const Mode& mode) {
+    current_mode = mode;
+}
+
+std::pair<u32, u32> PackedSize(const Mode& mode, bool swapped, u32 scale) {
+    u32 width = static_cast<u32>(Core::kScreenTopWidth);
+    u32 height = static_cast<u32>(Core::kScreenTopHeight + Core::kScreenBottomHeight);
+    if (mode.single) {
+        width = static_cast<u32>(swapped ? Core::kScreenBottomWidth : Core::kScreenTopWidth);
+        height = static_cast<u32>(swapped ? Core::kScreenBottomHeight : Core::kScreenTopHeight);
+    }
+    if (mode.stereo) {
+        width *= 2;
+    }
+    return {width * scale, height * scale};
+}
+
+std::vector<retro_video_view> BuildMap(const Layout::FramebufferLayout& layout, bool stereo,
+                                       bool swapped) {
+    // Screens number in the order Prominent 3DS Screen puts them; a screen shown alone is 0.
+    const unsigned top = (swapped && layout.bottom_screen_enabled) ? 1 : 0;
+    const unsigned bottom = (!swapped && layout.top_screen_enabled) ? 1 : 0;
+    std::vector<retro_video_view> views;
+    if (layout.top_screen_enabled && stereo) {
+        views.push_back(MakeView(layout.top_screen, 0, top, RETRO_VIDEO_VIEW_EYE_LEFT));
+        // The right eye is where the full side-by-side draw puts it: see
+        // RendererOpenGL::DrawTopScreen() in src/video_core/renderer_opengl/renderer_opengl.cpp and
+        // RendererVulkan::DrawTopScreen() in src/video_core/renderer_vulkan/renderer_vulkan.cpp.
+        views.push_back(
+            MakeView(layout.top_screen, layout.width / 2, top, RETRO_VIDEO_VIEW_EYE_RIGHT));
+    } else if (layout.top_screen_enabled) {
+        views.push_back(MakeView(layout.top_screen, 0, top, RETRO_VIDEO_VIEW_EYE_NONE));
+    }
+    if (layout.bottom_screen_enabled) {
+        views.push_back(MakeView(layout.bottom_screen, 0, bottom, RETRO_VIDEO_VIEW_EYE_NONE));
+    }
+    return views;
+}
+
+} // namespace LibRetro::VideoViews
diff --git a/src/citra_libretro/video_views.h b/src/citra_libretro/video_views.h
new file mode 100644
index 0000000..3607023
--- /dev/null
+++ b/src/citra_libretro/video_views.h
@@ -0,0 +1,45 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv3 or any later version
+// Refer to the LICENSE.txt file included.
+
+#pragma once
+
+#include <utility>
+#include <vector>
+#include "citra_libretro/libretro_views.h"
+#include "common/common_types.h"
+#include "common/settings.h"
+#include "core/frontend/framebuffer_layout.h"
+
+namespace LibRetro::VideoViews {
+
+/// Whether the frame is packed for the frontend's views, in stereo, and with one screen.
+struct Mode {
+    bool active = false; ///< The frontend lays out the screens.
+    bool stereo = false; ///< Both eyes are drawn and shown.
+    bool single = false; ///< Only the prominent screen is sent, as Single Screen Only shows it.
+
+    bool operator==(const Mode&) const = default;
+};
+
+/// The mode for the "Frontend Layout and 3D" option (true for Auto), the user's own Screen
+/// Layout, Stereoscopic 3D Mode and Prominent 3DS Screen (true for Bottom), the frontend's
+/// RETRO_VIDEO_VIEWS_STATUS_ flags, and whether the renderer draws both eyes.
+Mode SelectMode(bool frontend_layout, Settings::LayoutOption own_layout,
+                Settings::StereoRenderOption own_3d, bool swapped, unsigned status,
+                bool renderer_stereo);
+
+/// The mode Azahar's layout currently follows.
+const Mode& CurrentMode();
+void SetCurrentMode(const Mode& mode);
+
+/// The packed frame's size at a resolution factor: Azahar's default layout, or the prominent
+/// screen alone for Single Screen Only, twice as wide in stereo for the full side-by-side draw.
+std::pair<u32, u32> PackedSize(const Mode& mode, bool swapped, u32 scale);
+
+/// The view map for a layout computed for the views packing. Screens number from 0 in the
+/// order Prominent 3DS Screen puts them, and a screen the layout leaves out has no view.
+std::vector<retro_video_view> BuildMap(const Layout::FramebufferLayout& layout, bool stereo,
+                                       bool swapped);
+
+} // namespace LibRetro::VideoViews
