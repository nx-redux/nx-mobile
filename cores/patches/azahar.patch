+        baseY = Core::kScreenTopHeight + static_cast<unsigned>(Core::kScreenBottomHeight / p);
         baseX *= scaling;
         baseY *= scaling;
         break;
     }
+    }
 
     return {baseX, baseY, emulated_pointer};
 }
