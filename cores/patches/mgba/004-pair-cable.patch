+		GBASIOLockstepCoordinatorAttach(&pairCoordinator, &pairDrivers[i]);
+		pairCores[i]->setPeripheral(pairCores[i], mPERIPH_GBA_LINK_PORT, &pairDrivers[i].d);
+	}
+	pairLinked = true;
+	pairStallLogged = false;
