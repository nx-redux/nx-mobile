+/* mGBA's states keep the serial registers as the game wrote them, and a load
+ * writes them back in address order while the old mode is still set: the
+ * mode-dependent data registers can be dropped and the live RCNT / SIOCNT
+ * bits (ready, clock) are lost. Pair mode saves them as they are and puts
+ * them back after the load. */
+static void _pairSaveLinkRegisters(unsigned i, uint8_t* out) {
+	struct GBA* gba = pairCores[i]->board;
+	memcpy(out, &gba->memory.io[GBA_REG(SIODATA32_LO)], PAIR_LINK_REGS_SIZE);
+	STORE_16LE(gba->sio.rcnt, PAIR_LINK_REGS_SIZE, out);
+	STORE_16LE(gba->sio.siocnt, PAIR_LINK_REGS_SIZE + 2, out);
+	STORE_32LE(gba->sio.mode, PAIR_LINK_REGS_SIZE + 4, out);
+}
+
+static void _pairLoadLinkRegisters(unsigned i, const uint8_t* in) {
+	struct GBA* gba = pairCores[i]->board;
+	int32_t mode;
+	memcpy(&gba->memory.io[GBA_REG(SIODATA32_LO)], in, PAIR_LINK_REGS_SIZE);
+	LOAD_16LE(gba->sio.rcnt, PAIR_LINK_REGS_SIZE, in);
+	LOAD_16LE(gba->sio.siocnt, PAIR_LINK_REGS_SIZE + 2, in);
+	LOAD_32LE(mode, PAIR_LINK_REGS_SIZE + 4, in);
+	gba->sio.mode = mode;
+}
+
+static bool _pairSerialize(void* out, size_t size) {
+	if (size < pairStateSize) {
+		return false;
+	}
+	uint8_t* bytes = out;
+	memset(bytes, 0, pairStateSize);
+	STORE_32LE(PAIR_STATE_MAGIC, 0, bytes);
+	STORE_32LE(PAIR_STATE_VERSION, 4, bytes);
+	size_t offset = PAIR_HEADER_SIZE;
+	unsigned i;
+	for (i = 0; i < 2; ++i) {
+		_pairSaveLinkRegisters(i, &bytes[16 + i * PAIR_LINK_SIZE]);
+		struct VFile* vfm = VFileMemChunk(NULL, 0);
+		mCoreSaveStateNamed(pairCores[i], vfm, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+		size_t length = vfm->size(vfm);
+		if (offset + length > pairStateSize) {
+			vfm->close(vfm);
+			return false;
+		}
+		vfm->seek(vfm, 0, SEEK_SET);
+		vfm->read(vfm, &bytes[offset], length);
+		vfm->close(vfm);
+		STORE_32LE(length, 8 + 4 * i, bytes);
+		offset += length;
+	}
+	return true;
+}
+
+/* Loading a GBA's registers re-runs its SIO mode switch, which tells the
+ * other GBA's player through the coordinator. Once both GBAs are loaded,
+ * their link drivers' own states are applied again, over those messages. */
+static bool _pairReloadLink(unsigned i, const void* state, size_t length) {
+	struct mStateExtdata extdata;
+	struct mStateExtdataItem item;
+	bool ok = false;
+	mStateExtdataInit(&extdata);
+	struct VFile* vf = VFileFromConstMemory(state, length);
+	if (mCoreExtractExtdata(pairCores[i], vf, &extdata) &&
+	    mStateExtdataGet(&extdata, EXTDATA_SUBSYSTEM_START + GBA_SUBSYSTEM_SIO_DRIVER, &item) &&
+	    item.size > (ssize_t) sizeof(uint32_t)) {
+		struct GBA* gba = pairCores[i]->board;
+		mTimingDeschedule(&gba->timing, &pairDrivers[i].event);
+		ok = pairDrivers[i].d.loadState(&pairDrivers[i].d, (const uint8_t*) item.data + sizeof(uint32_t),
+		                                item.size - sizeof(uint32_t));
+	}
+	vf->close(vf);
+	mStateExtdataDeinit(&extdata);
+	return ok;
+}
+
+/* Whether a GBA's part of a pair state will load: this build's state version,
+ * this GBA's game, and its link driver's state. Checked for both GBAs before
+ * either is touched, so a refused state leaves the pair as it was. */
+static bool _pairCheckState(unsigned i, const uint8_t* state, size_t length) {
+	struct mCore* gbaCore = pairCores[i];
+	struct GBA* gba = gbaCore->board;
+	if (length < gbaCore->stateSize(gbaCore) || !gba->memory.rom) {
+		return false;
+	}
+	const struct GBASerializedState* gbaState = (const struct GBASerializedState*) state;
+	// The header GBADeserialize compares against
+	const struct GBACartridge* cart = (const struct GBACartridge*) (gba->memory.unl.type == GBA_UNL_CART_MULTICART ?
+	                                                                gba->memory.unl.multi.rom : gba->memory.rom);
+	uint32_t magic;
+	LOAD_32LE(magic, 0, &gbaState->versionMagic);
+	if (magic != GBASavestateMagic + GBASavestateVersion || gbaState->id != cart->id ||
+	    memcmp(gbaState->title, cart->title, sizeof(gbaState->title)) != 0) {
+		return false;
+	}
+	struct mStateExtdata extdata;
+	struct mStateExtdataItem item;
+	mStateExtdataInit(&extdata);
+	struct VFile* vf = VFileFromConstMemory(state, length);
+	bool ok = mCoreExtractExtdata(gbaCore, vf, &extdata) &&
+	          mStateExtdataGet(&extdata, EXTDATA_SUBSYSTEM_START + GBA_SUBSYSTEM_SIO_DRIVER, &item) &&
+	          item.size > (ssize_t) sizeof(uint32_t);
+	vf->close(vf);
+	mStateExtdataDeinit(&extdata);
+	return ok;
+}
+
+static bool _pairUnserialize(const void* in, size_t size) {
+	const uint8_t* bytes = in;
+	uint32_t magic, version, length[2];
+	if (size < PAIR_HEADER_SIZE) {
+		return false;
+	}
+	LOAD_32LE(magic, 0, bytes);
+	LOAD_32LE(version, 4, bytes);
+	LOAD_32LE(length[0], 8, bytes);
+	LOAD_32LE(length[1], 12, bytes);
+	if (magic != PAIR_STATE_MAGIC || version != PAIR_STATE_VERSION ||
+	    (uint64_t) PAIR_HEADER_SIZE + length[0] + length[1] > size) {
+		return false;
+	}
+	const uint8_t* state[2] = { &bytes[PAIR_HEADER_SIZE], &bytes[PAIR_HEADER_SIZE + length[0]] };
+	if (!_pairCheckState(0, state[0], length[0]) || !_pairCheckState(1, state[1], length[1])) {
+		return false;
+	}
+	bool ok = true;
+	unsigned i;
+	for (i = 0; i < 2; ++i) {
+		// With its save, written into the save buffer like the game would:
+		// both phones must play on the same saves.
+		struct VFile* vf = VFileFromConstMemory(state[i], length[i]);
+		ok = mCoreLoadStateNamed(pairCores[i], vf, SAVESTATE_SAVEDATA | SAVESTATE_RTC) && ok;
+		vf->close(vf);
+	}
+	for (i = 0; ok && i < 2; ++i) {
+		ok = _pairReloadLink(i, state[i], length[i]);
+		_pairLoadLinkRegisters(i, &bytes[16 + i * PAIR_LINK_SIZE]);
+	}
+	return ok;
+}
+
+static uint64_t _pairHashBytes(uint64_t hash, const void* data, size_t size) {
+	const uint8_t* bytes = data;
+	size_t i;
+	for (i = 0; i < size; ++i) {
+		hash ^= bytes[i];
+		hash *= 0x100000001B3ULL;
+	}
+	return hash;
+}
+
+/* FNV-1a over what the phones must agree on, read from the live GBAs: their
+ * emulated time, CPU, memory, I/O and serial registers, and saves. Not their
+ * save states: mGBA stores some lazily updated timings (audio channels, a few
+ * events) in a form that a load changes while the emulation stays the same.
+ * Video and audio output are not part of it. All supported devices are
+ * little-endian, so the bytes are the same on each. 0 outside pair mode. */
+RETRO_API uint64_t nx_pair_hash(void) {
+	if (!pairMode || !core) {
+		return 0;
+	}
+	if (deferredSetup) {
+		_doDeferredSetup();
+	}
+	uint64_t hash = 0xCBF29CE484222325ULL;
+	unsigned i;
+	for (i = 0; i < 2; ++i) {
+		struct mCore* gbaCore = pairCores[i];
+		struct GBA* gba = gbaCore->board;
+		struct ARMCore* cpu = gba->cpu;
+		uint64_t time = mTimingGlobalTime(&gba->timing);
+		hash = _pairHashBytes(hash, &time, sizeof(time));
+		hash = _pairHashBytes(hash, cpu->gprs, sizeof(cpu->gprs));
+		hash = _pairHashBytes(hash, &cpu->cpsr.packed, sizeof(cpu->cpsr.packed));
+		hash = _pairHashBytes(hash, &cpu->spsr.packed, sizeof(cpu->spsr.packed));
+		hash = _pairHashBytes(hash, cpu->bankedRegisters, sizeof(cpu->bankedRegisters));
+		hash = _pairHashBytes(hash, cpu->bankedSPSRs, sizeof(cpu->bankedSPSRs));
+		uint8_t halted = cpu->halted;
+		hash = _pairHashBytes(hash, &halted, sizeof(halted));
+		hash = _pairHashBytes(hash, gba->memory.wram, GBA_SIZE_EWRAM);
+		hash = _pairHashBytes(hash, gba->memory.iwram, GBA_SIZE_IWRAM);
+		hash = _pairHashBytes(hash, gba->video.palette, GBA_SIZE_PALETTE_RAM);
+		hash = _pairHashBytes(hash, gba->video.vram, GBA_SIZE_VRAM);
+		hash = _pairHashBytes(hash, gba->video.oam.raw, GBA_SIZE_OAM);
+		hash = _pairHashBytes(hash, gba->memory.io, sizeof(gba->memory.io));
+		hash = _pairHashBytes(hash, &gba->sio.rcnt, sizeof(gba->sio.rcnt));
+		hash = _pairHashBytes(hash, &gba->sio.siocnt, sizeof(gba->sio.siocnt));
+		hash = _pairHashBytes(hash, gba->memory.hw.rtc.time, sizeof(gba->memory.hw.rtc.time));
+		hash = _pairHashBytes(hash, &gba->memory.hw.rtc.control, sizeof(gba->memory.hw.rtc.control));
+		struct GBASIOLockstepPlayer* player = _pairPlayer(i);
+		if (player) {
+			int32_t mode = player->mode;
+			uint8_t dataReceived = player->dataReceived;
+			hash = _pairHashBytes(hash, &mode, sizeof(mode));
+			hash = _pairHashBytes(hash, &dataReceived, sizeof(dataReceived));
+		}
+		void* sram = NULL;
+		size_t sramSize = gbaCore->savedataClone(gbaCore, &sram);
+		hash = _pairHashBytes(hash, sram, sramSize);
+		free(sram);
+	}
+	return hash;
+}
