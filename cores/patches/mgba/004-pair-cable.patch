+/* GBA 1 is the cable's player 0 (the clock owner), GBA 2 player 1. */
+static void _pairLink(void) {
+	GBASIOLockstepCoordinatorInit(&pairCoordinator);
+	unsigned i;
+	for (i = 0; i < 2; ++i) {
+		pairUsers[i] = (struct PairUser) {
