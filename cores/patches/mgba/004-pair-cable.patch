+static struct GBASIOLockstepPlayer* _pairPlayer(unsigned i) {
+	return TableLookup(&pairCoordinator.players, pairDrivers[i].lockstepId);
+}
+
+/* One frame of both GBAs. The GBA behind on the cable's clock runs next, one
+ * event period at a time, so the two stay close in emulated time unless one
+ * is asleep in the coordinator, waiting on the other. A GBA that has finished
+ * its frame runs on into its vblank only while the other cannot run without
+ * it. */
+static void _pairRunFrame(void) {
+	struct GBA* gbas[2] = { pairCores[0]->board, pairCores[1]->board };
+	uint32_t frame[2];
+	int32_t start[2];
+	unsigned i;
+	for (i = 0; i < 2; ++i) {
+		frame[i] = gbas[i]->video.frameCounter;
+		start[i] = mTimingCurrentTime(&gbas[i]->timing);
+	}
+	while (true) {
+		bool done[2];
+		bool awake[2];
+		int32_t now[2];
+		for (i = 0; i < 2; ++i) {
+			struct GBASIOLockstepPlayer* player = _pairPlayer(i);
+			int32_t cycle = mTimingCurrentTime(&gbas[i]->timing);
+			done[i] = gbas[i]->video.frameCounter != frame[i] ||
+			          cycle - start[i] >= VIDEO_TOTAL_LENGTH + VIDEO_HORIZONTAL_LENGTH;
+			awake[i] = !player || !player->asleep;
+			now[i] = cycle - (player ? player->cycleOffset : 0);
+		}
+		if (done[0] && done[1]) {
+			break;
+		}
+		int pick = -1;
+		int pass;
+		for (pass = 0; pass < 2 && pick < 0; ++pass) {
+			for (i = 0; i < 2; ++i) {
+				if (!awake[i] || (pass == 0 && done[i])) {
+					continue;
+				}
+				if (pick < 0 || now[i] - now[pick] < 0) {
+					pick = i;
+				}
+			}
+		}
+		if (pick < 0) {
+			if (!pairStallLogged) {
+				mLOG(GBA_SIO, ERROR, "Pair: both GBAs are waiting on each other");
+				pairStallLogged = true;
+			}
+			break;
+		}
+		pairCores[pick]->runLoop(pairCores[pick]);
+	}
+	struct mCore* other = pairCores[!pairLocal];
+	mAudioBufferClear(other->getAudioBuffer(other));
+}
