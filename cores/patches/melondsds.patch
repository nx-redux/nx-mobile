+constexpr uint8_t REPLY_FLAGS = 0x81;
+const uint8_t MP_CMD_MAC[6] = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x00};
+const uint8_t MP_REPLY_MAC[6] = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x10};
