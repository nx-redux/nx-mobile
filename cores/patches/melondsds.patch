+        offer.host = host;
+        offer.gameId = gameId;
+        offer.streamCode = stream;
+        offer.channel = frame[9];
+        offer.beaconInterval = Le16(frame + RX_HEADER + MAC_HEADER + 8);
+        offer.cmdDataSize = Le16(dd + 0x14);
+        std::copy_n(d, offer.icon.size(), offer.icon.begin());
+        offer.hostName = Ucs2(d + 0x222, std::min<size_t>(d[0x221], 10));
+        offer.players = g.players;
+        offer.maxPlayers = d[0x236];
+        offer.gameName = Ucs2(d + 0x238, 48);
+        offer.description = Ucs2(d + 0x298, 96);
+        _offers[host] = offer;
+        return true;
+    }
+    return false;
+}
+
+void WmbScanner::Forget(uint64_t nowMs) noexcept {
+    for (auto it = _gathering.begin(); it != _gathering.end();) {
+        if (nowMs - it->second.heardAt > HOST_FORGET_MS) {
+            _offers.erase(it->first);
+            it = _gathering.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+uint16_t WmbScanner::SnippetsHeard(const WmbMac& host) const noexcept {
+    const auto it = _gathering.find(host);
+    return it == _gathering.end() ? 0 : it->second.have;
+}
+
+void WmbClient::Start(const WmbOffer& offer, const WmbMac& mac, const std::u16string& username, uint64_t nowMs) noexcept {
+    *this = WmbClient {};
+    _offer = offer;
+    _mac = mac;
+    _username = username.substr(0, 10);
+    _payload = offer.cmdDataSize > 6 ? offer.cmdDataSize - 6 : 0;
+    _state = State::Auth;
+    _beaconsSinceAsk = BEACONS_PER_ASK; // ask at the next beacon
+    _hostHeardAt = nowMs;
+}
+
+void WmbClient::Cancel() noexcept {
+    _state = State::Idle;
+}
+
+void WmbClient::Tick(uint64_t nowMs) noexcept {
+    const bool waiting = _state == State::Auth || _state == State::Assoc || _state == State::Download;
+    if (waiting && nowMs - _hostHeardAt > HOST_SILENT_MS) {
+        _state = State::Failed;
+        _failure = Failure::HostGone;
+    }
+}
+
+std::vector<uint8_t> WmbClient::Management(uint16_t fc, const std::vector<uint8_t>& body) noexcept {
+    std::vector<uint8_t> f(8, 0);
+    f.push_back(0x14);
+    f.push_back(_offer.channel);
+    Put16(f, 24 + body.size() + 4);
+    Put16(f, fc);
+    Put16(f, 0);
+    PutMac(f, _offer.host.data());
+    PutMac(f, _mac.data());
+    PutMac(f, _offer.host.data());
+    Put16(f, _seq++ << 4);
+    f.insert(f.end(), body.begin(), body.end());
+    f.insert(f.end(), 4, 0); // FCS: melonDS doesn't check it
+    return f;
+}
+
+std::vector<uint8_t> WmbClient::Reply(const uint8_t* cmdFrame, const std::array<uint8_t, 8>& body) noexcept {
+    std::vector<uint8_t> f(8, 0);
+    f.push_back(0x14);
+    f.push_back(cmdFrame[9]);
+    Put16(f, 24 + 10 + 4);
+    Put16(f, 0x0118);
+    Put16(f, 0);
+    PutMac(f, _offer.host.data());
+    PutMac(f, _mac.data());
+    PutMac(f, MP_REPLY_MAC);
+    Put16(f, _seq++ << 4);
+    f.push_back(4); // halfwords of reply data
+    f.push_back(REPLY_FLAGS);
+    f.insert(f.end(), body.begin(), body.end());
+    f.insert(f.end(), 4, 0);
+    return f;
+}
+
+uint32_t WmbClient::RegionSize(int region) const noexcept {
+    if (region == 0) return HEADER_SIZE;
+    return Le32(_rsa.data() + (region == 1 ? 0x24 : 0x34));
+}
+
+uint32_t WmbClient::RegionPackets(int region) const noexcept {
+    return _payload ? (uint64_t(RegionSize(region)) + _payload - 1) / _payload : 0;
+}
+
+uint32_t WmbClient::PacketsTotal() const noexcept {
+    if (!_haveRsa) return 0;
+    return RegionPackets(0) + RegionPackets(1) + RegionPackets(2);
+}
+
+std::vector<uint8_t> WmbClient::Region(int region) const noexcept {
+    if (!_haveRsa || region < 0 || region > 2) return {};
+    uint32_t first = 0;
+    for (int r = 0; r < region; r++) first += RegionPackets(r);
+    std::vector<uint8_t> out;
+    for (uint32_t n = first; n < first + RegionPackets(region); n++) {
+        const auto it = _packets.find(n);
+        if (it == _packets.end()) return {};
+        out.insert(out.end(), it->second.begin(), it->second.end());
+    }
+    out.resize(RegionSize(region));
+    return out;
+}
+
+std::array<uint8_t, 8> WmbClient::DataReply() const noexcept {
+    std::array<uint8_t, 8> reply {};
+    if (_packets.size() >= PacketsTotal()) {
+        reply[0] = 0x0A; // got all
+        return reply;
+    }
+    uint16_t next = 0;
+    while (_packets.count(next)) next++;
+    reply[0] = 0x09;
+    reply[1] = next & 0xFF;
+    reply[2] = next >> 8;
+    reply[3] = _packets.size() & 0xFF;
+    reply[4] = _packets.size() >> 8;
+    return reply;
+}
+
+void WmbClient::FrameReceived(const uint8_t* f, size_t len, uint64_t timestamp, bool cmd, uint64_t nowMs,
+                              std::vector<WmbOutgoing>& out) noexcept {
+    if (_state != State::Auth && _state != State::Assoc && _state != State::Download) return;
+    if (len < RX_HEADER + MAC_HEADER) return;
+    const uint8_t* mac = f + RX_HEADER;
+    const uint16_t fc = Le16(mac);
+    const uint8_t* body = mac + MAC_HEADER;
+    const size_t bodyLen = len - RX_HEADER - MAC_HEADER;
+    if (MacAt(mac + 10) != _offer.host) return;
+    _hostHeardAt = nowMs;
+    const bool toUs = MacAt(mac + 4) == _mac;
+
+    if (fc == 0x0080 && (_state == State::Auth || _state == State::Assoc)) {
+        // A host only listens for joiners right after its beacons: ask again then, until it answers.
+        if (++_beaconsSinceAsk < BEACONS_PER_ASK) return;
+        _beaconsSinceAsk = 0;
+        if (_state == State::Auth) {
+            out.push_back({Management(0x00B0, {0, 0, 1, 0, 0, 0}), timestamp});
+            return;
+        }
+        std::vector<uint8_t> b;
+        Put16(b, 0x0021); // capability
+        Put16(b, 0x0001); // listen interval
+        b.push_back(0x00);
+        b.push_back(0x20); // SSID: game id and stream code, zero-padded
+        for (int i = 0; i < 4; i++) b.push_back(_offer.gameId >> (8 * i));
+        Put16(b, _offer.streamCode);
+        b.insert(b.end(), 0x1A, 0);
+        b.insert(b.end(), {0x01, 0x02, 0x82, 0x84}); // rates
+        out.push_back({Management(0x0000, b), timestamp});
+        return;
+    }
+    if (fc == 0x00B0 && toUs && _state == State::Auth && bodyLen >= 6 && Le16(body + 2) == 2 && Le16(body + 4) == 0) {
+        _state = State::Assoc;
+        _beaconsSinceAsk = BEACONS_PER_ASK;
+        return;
+    }
+    if (fc == 0x0010 && toUs && _state == State::Assoc && bodyLen >= 6 && Le16(body + 2) == 0) {
+        _aid = Le16(body + 4) & 0x0F;
+        _state = State::Download;
+        return;
+    }
+    if (_state != State::Download || !cmd || fc != 0x0228 || std::memcmp(mac + 4, MP_CMD_MAC, 6) != 0 || bodyLen < 7) return;
+
+    std::array<uint8_t, 8> reply {};
+    switch (body[6]) {
+    case 0x01: { // NameRequest: the username in 6-byte snippets
+        reply[0] = 0x07;
+        reply[1] = _nameSnippet;
+        auto put = [&](int at, uint16_t x) { reply[at] = x & 0xFF; reply[at + 1] = x >> 8; };
+        auto ch = [&](size_t i) -> uint16_t { return i < _username.size() ? _username[i] : 0; };
+        if (_nameSnippet == 0) {
+            put(2, _offer.gameId & 0xFFFF);
+            put(4, _offer.gameId >> 16);
+            reply[6] = 0x0F; // favourite colour
+            reply[7] = _username.size();
+        } else if (_nameSnippet < 4) {
+            for (int i = 0; i < 3; i++) put(2 + i * 2, ch((_nameSnippet - 1) * 3 + i));
+        } else {
+            put(2, ch(9));
+            put(4, 0x0002);
+        }
+        _nameSnippet = (_nameSnippet + 1) % 5;
+        break;
+    }
+    case 0x03: // RSA frame: the binaries' addresses and sizes
+        if (!_haveRsa && bodyLen >= 7 + _rsa.size()) {
+            std::copy_n(body + 7, _rsa.size(), _rsa.begin());
+            _haveRsa = true;
+        }
+        reply[0] = 0x08;
+        break;
+    case 0x04: { // Data
+        if (!_haveRsa || bodyLen < 11) break;
+        const uint16_t number = Le16(body + 9);
+        const size_t dataLen = std::min<size_t>({size_t(std::max(0, body[4] * 2 - 6)), bodyLen - 11, _payload});
+        if (number < PacketsTotal() && !_packets.count(number)) _packets[number].assign(body + 11, body + 11 + dataLen);
+        reply = DataReply();
+        break;
+    }
+    case 0x05: // Final
+        reply[0] = 0x0B;
+        out.push_back({Reply(f, reply), ReplyTime(timestamp, len), _aid, true});
+        out.push_back({Management(0x00C0, {3, 0}), ReplyTime(timestamp, len)});
+        if (_haveRsa && _packets.size() >= PacketsTotal()) {
+            _state = State::Done;
+        } else {
+            _state = State::Failed;
+            _failure = Failure::BadDownload;
+        }
+        return;
+    default: // nothing asked (00 after each phase): where this client stands, as a real client answers
+        if (_haveRsa && !_packets.empty()) reply = DataReply();
+        else if (_haveRsa) reply[0] = 0x08;
+        break;
+    }
+    out.push_back({Reply(f, reply), ReplyTime(timestamp, len), _aid, true});
+}
+
+std::array<uint8_t, 0x40> WmbClient::BootBlock() const noexcept {
+    std::array<uint8_t, 0x40> b {};
+    auto put16 = [&](size_t at, uint16_t x) { b[at] = x & 0xFF; b[at + 1] = x >> 8; };
+    put16(0x00, 2);      // booted from DS Download Play
+    put16(0x02, 0x60);   // beacon size
+    put16(0x04, 0x82);   // signal strength
+    std::copy(_offer.host.begin(), _offer.host.end(), b.begin() + 0x06);
+    put16(0x0C, 0x20);   // SSID size
+    put16(0x0E, _offer.gameId & 0xFFFF);
+    put16(0x10, _offer.gameId >> 16);
+    put16(0x12, _offer.streamCode);
+    put16(0x2E, 0x0021); // capability
+    put16(0x30, 0x0003); // rates
+    put16(0x32, 0x0003);
+    put16(0x34, _offer.beaconInterval);
+    put16(0x36, 0x0002); // TIM listen interval
+    put16(0x38, _offer.channel);
+    return b;
+}
+
+std::optional<WmbChild> MelonDsDs::MakeWmbChild(const std::vector<uint8_t>& header, const std::vector<uint8_t>& arm9,
+                                                const std::vector<uint8_t>& arm7, const std::array<uint8_t, 0x40>& bootBlock) noexcept {
+    if (header.size() < HEADER_SIZE) return std::nullopt;
+    const uint64_t arm9At = Le32(header.data() + 0x20), arm7At = Le32(header.data() + 0x30);
+    // A forged header could ask for gigabytes: the DS has 4 MB of main RAM, so its binaries sit well inside 32 MB.
+    constexpr uint64_t ROM_MAX = 32 << 20;
+    if (arm9At < HEADER_SIZE || arm7At < HEADER_SIZE || arm9At + arm9.size() > ROM_MAX || arm7At + arm7.size() > ROM_MAX)
+        return std::nullopt;
+    WmbChild child;
+    child.rom.resize(std::max(arm9At + arm9.size(), arm7At + arm7.size()));
+    std::copy(header.begin(), header.end(), child.rom.begin());
+    std::copy(arm9.begin(), arm9.end(), child.rom.begin() + arm9At);
+    std::copy(arm7.begin(), arm7.end(), child.rom.begin() + arm7At);
+    child.bootBlock = bootBlock;
+    return child;
+}
diff --git a/src/libretro/net/wmb.hpp b/src/libretro/net/wmb.hpp
new file mode 100644
index 0000000..40ec0a1
--- /dev/null
+++ b/src/libretro/net/wmb.hpp
@@ -0,0 +1,116 @@
+#pragma once
+// DS Download Play (Wireless Multiboot) from the guest's side, per GBATEK "DS Wifi Nintendo Beacons" and "DS Wifi
+// Nintendo DS Download Play". Frames are melonDS's: a 12-byte radio header, then the 802.11 frame. Pure: no logging,
+// no clock of its own (the caller passes milliseconds), so it runs in host tests.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace MelonDsDs {
+using WmbMac = std::array<uint8_t, 6>;
+
+/// What a Download Play host offers, gathered from its beacons.
+struct WmbOffer {
+    WmbMac host {};
+    uint32_t gameId = 0;
+    uint16_t streamCode = 0;
+    std::string hostName;    // UTF-8
+    std::string gameName;    // UTF-8
+    std::string description; // UTF-8
+    uint8_t players = 0;     // in the session now, from snippet #9
+    uint8_t maxPlayers = 0;
+    uint8_t channel = 0;
+    uint16_t beaconInterval = 0;
+    uint16_t cmdDataSize = 0; // bytes per host command (Tag DDh [14h])
+    std::array<uint8_t, 0x220> icon {}; // palette (0x20) then 4bpp bitmap (0x200), as a cartridge icon
+};
+
+/// Gathers the advertisements of every Download Play host heard.
+class WmbScanner {
+public:
+    /// True when [frame] completed a host's offer or changed it.
+    bool FrameReceived(const uint8_t* frame, size_t len, uint64_t nowMs) noexcept;
+    const std::map<WmbMac, WmbOffer>& Offers() const noexcept { return _offers; }
+    /// Drops hosts not heard for a while: a host that quit takes its offer with it.
+    void Forget(uint64_t nowMs) noexcept;
+    /// Bit n: snippet n (0..8) of [host]'s current advertisement heard.
+    uint16_t SnippetsHeard(const WmbMac& host) const noexcept;
+private:
+    struct Gathering {
+        uint32_t gameId = 0;
+        uint16_t streamCode = 0;
+        uint16_t have = 0;
+        uint8_t players = 0;
+        uint64_t heardAt = 0;
+        std::array<uint8_t, 9 * 0x62> data {};
+    };
+    std::map<WmbMac, Gathering> _gathering;
+    std::map<WmbMac, WmbOffer> _offers;
+};
+
+/// One frame the client sends: melonDS's 12-byte TX header, then the 802.11 frame.
+struct WmbOutgoing {
+    std::vector<uint8_t> frame;
+    uint64_t timestamp = 0;
+    uint8_t aid = 0;
+    bool reply = false; // an MP reply to the host's command, else a plain frame (auth, assoc, deauth)
+};
+
+/// Joins one host's offer, answers its commands and collects the header, ARM9 and ARM7 it sends.
+class WmbClient {
+public:
+    enum class State { Idle, Auth, Assoc, Download, Done, Failed };
+    enum class Failure { None, HostGone, BadDownload };
+    /// [mac]: the console's own address, which the received game rejoins the host with.
+    void Start(const WmbOffer& offer, const WmbMac& mac, const std::u16string& username, uint64_t nowMs) noexcept;
+    /// Every received frame; what to send in answer goes to [out].
+    void FrameReceived(const uint8_t* frame, size_t len, uint64_t timestamp, bool cmd, uint64_t nowMs,
+                       std::vector<WmbOutgoing>& out) noexcept;
+    /// Gives up on a host that went silent.
+    void Tick(uint64_t nowMs) noexcept;
+    void Cancel() noexcept;
+    State GetState() const noexcept { return _state; }
+    Failure GetFailure() const noexcept { return _failure; }
+    const WmbOffer& Offer() const noexcept { return _offer; }
+    uint32_t PacketsDone() const noexcept { return _packets.size(); }
+    uint32_t PacketsTotal() const noexcept;
+    /// Done only: the region (0 header, 1 ARM9, 2 ARM7) as the host sent it; empty if a packet is missing.
+    std::vector<uint8_t> Region(int region) const noexcept;
+    /// What the DS menu leaves at 027FFC40 for a received game: how it came (Download Play) and the host to rejoin.
+    std::array<uint8_t, 0x40> BootBlock() const noexcept;
+private:
+    std::vector<uint8_t> Reply(const uint8_t* cmdFrame, const std::array<uint8_t, 8>& body) noexcept;
+    std::vector<uint8_t> Management(uint16_t fc, const std::vector<uint8_t>& body) noexcept;
+    std::array<uint8_t, 8> DataReply() const noexcept;
+    uint32_t RegionSize(int region) const noexcept;
+    uint32_t RegionPackets(int region) const noexcept;
+    State _state = State::Idle;
+    Failure _failure = Failure::None;
+    WmbOffer _offer;
+    WmbMac _mac {};
+    std::u16string _username;
+    uint16_t _seq = 0;
+    uint8_t _aid = 0;
+    uint8_t _nameSnippet = 0;
+    uint32_t _payload = 0;
+    bool _haveRsa = false;
+    std::array<uint8_t, 0xE4> _rsa {};
+    std::map<uint16_t, std::vector<uint8_t>> _packets;
+    int _beaconsSinceAsk = 0;
+    uint64_t _hostHeardAt = 0;
+};
+
+/// A received game as a cart would hold it, and the block to leave at 027FFC40.
+struct WmbChild {
+    std::vector<uint8_t> rom;
+    std::array<uint8_t, 0x40> bootBlock {};
+};
+
+/// Each binary placed where the header says a cart holds it; nothing when the header is unusable.
+std::optional<WmbChild> MakeWmbChild(const std::vector<uint8_t>& header, const std::vector<uint8_t>& arm9,
+                                     const std::vector<uint8_t>& arm7, const std::array<uint8_t, 0x40>& bootBlock) noexcept;
+}
