+#include "wmb.hpp"
+#include <algorithm>
+#include <cstring>
+
+using namespace MelonDsDs;
+
+namespace {
+constexpr size_t RX_HEADER = 12;
+constexpr size_t MAC_HEADER = 24;
+constexpr size_t BEACON_FIXED = 12; // timestamp, interval, capability
+constexpr size_t SNIPPET = 0x62;
+constexpr uint16_t SNIPPETS_0_TO_8 = 0x1FF;
+constexpr uint64_t HOST_FORGET_MS = 5000;
+constexpr uint64_t HOST_SILENT_MS = 3000;
+constexpr uint32_t HEADER_SIZE = 0x160;
