 void Platform::MP_Begin(void*) {
     ZoneScopedN(TracyFunction);
+    MelonDsDs::NdsRadioOn();
 }
 
 void Platform::MP_End(void*) {
     ZoneScopedN(TracyFunction);
+    MelonDsDs::NdsRadioOff();
 }
