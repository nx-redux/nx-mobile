+void MelonDsDs::CoreState::BootWmbChild(WmbChild child) noexcept {
+    auto cart = melonDS::NDSCart::ParseROM(child.rom.data(), child.rom.size(), nullptr, std::nullopt);
+    if (!cart) {
+        retro::warn("WMB: the downloaded game is not a ROM melonDS can load");
+        return;
+    }
+    Console->SetNDSCart(std::move(cart));
+    Console->Reset();
+    SetConsoleTime(*Console);
+    Console->SetupDirectBoot("download-play.nds");
+    for (size_t i = 0; i < child.bootBlock.size(); i++) Console->MainRAM[(0x027FFC40 + i) & Console->MainRAMMask] = child.bootBlock[i];
+    Console->Start();
+    retro::info("WMB: booted the downloaded game ({} bytes)", child.rom.size());
+    std::thread([] {
+        for (int i = 0; i < 60; i++) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            retro::info("WMB watch: {}", MelonDsDs::WmbPhase.load());
+        }
+    }).detach();
+}
