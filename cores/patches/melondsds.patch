-// Not much we can do in Begin and End
+namespace {
+    bool radioOn = false;
+    bool hostingReported = false;
+    // Until then a radio turned off is not reported: the reset that boots a received game would drop the room it
+    // rejoins its host through.
+    std::chrono::steady_clock::time_point holdRadioUntil {};
+
+    void ReportRadio(unsigned state) noexcept {
+        retro::environment(NX_ENVIRONMENT_SET_NDS_RADIO, &state);
+    }
+}
+
+void MelonDsDs::NdsRadioOn() noexcept {
+    radioOn = true;
+    hostingReported = false;
+    ReportRadio(NX_NDS_RADIO_ON);
+}
+
+void MelonDsDs::NdsRadioOff() noexcept {
+    if (!radioOn || std::chrono::steady_clock::now() < holdRadioUntil) {
+        return;
+    }
+    radioOn = false;
+    hostingReported = false;
+    ReportRadio(NX_NDS_RADIO_OFF);
+}
+
+void MelonDsDs::NdsDownloadPlayStarted() noexcept {
+    constexpr auto BOOT_HOLD = std::chrono::seconds(10);
+    holdRadioUntil = std::chrono::steady_clock::now() + BOOT_HOLD;
+    radioOn = true;
+    ReportRadio(NX_NDS_RADIO_DLP_STARTED);
+}
+
+void MelonDsDs::NdsDownloadPlayHostLeft() noexcept {
+    ReportRadio(NX_NDS_RADIO_HOST_LEFT);
+}
+
+void MelonDsDs::NdsRadioSawFrame(const uint8_t* txFrame, int len) noexcept {
+    // The game's own beacon means it created a group; melonDS puts a 12-byte TX header before the 802.11 frame, whose
+    // frame control starts 0x80 0x00 for a beacon.
+    constexpr int TX_HEADER_LENGTH = 12;
+    if (!radioOn || hostingReported || len < TX_HEADER_LENGTH + 2) {
+        return;
+    }
+    if (txFrame[TX_HEADER_LENGTH] == 0x80 && txFrame[TX_HEADER_LENGTH + 1] == 0x00) {
+        hostingReported = true;
+        ReportRadio(NX_NDS_RADIO_HOSTING);
+    }
+}
+
 void Platform::MP_Begin(void*) {
     ZoneScopedN(TracyFunction);
+    MelonDsDs::NdsRadioOn();
 }
 
 void Platform::MP_End(void*) {
     ZoneScopedN(TracyFunction);
+    MelonDsDs::NdsRadioOff();
 }
