+    }
+}
+
+void MelonDsDs::NdsRadioOn() noexcept {
+    radioOn = true;
+    hostingReported = false;
+    ReportRadio(NX_NDS_RADIO_ON);
+}
+
+void MelonDsDs::NdsRadioOff() noexcept {
+    if (!radioOn) {
+        return;
+    }
+    radioOn = false;
+    hostingReported = false;
+    ReportRadio(NX_NDS_RADIO_OFF);
+}
+
+void MelonDsDs::NdsRadioSawFrame(const uint8_t* txFrame, int len) noexcept {
+    // The game's own beacon means it created a group; melonDS puts a 12-byte TX header before the 802.11 frame, whose
+    // frame control starts 0x80 0x00 for a beacon.
+    constexpr int TX_HEADER_LENGTH = 12;
+    if (!radioOn || hostingReported || len < TX_HEADER_LENGTH + 2) {
+        return;
+    }
+    if (txFrame[TX_HEADER_LENGTH] == 0x80 && txFrame[TX_HEADER_LENGTH + 1] == 0x00) {
+        hostingReported = true;
+        ReportRadio(NX_NDS_RADIO_HOSTING);
+    }
+}
