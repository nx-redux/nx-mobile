index 0000000..39608e2
--- /dev/null
+++ b/src/libretro/net/wmb.cpp
@@ -0,0 +1,395 @@
+#include "wmb.hpp"
+#include <algorithm>
+#include <cstring>
+
+using namespace MelonDsDs;
+
+namespace {
+constexpr size_t RX_HEADER = 12;
+constexpr size_t MAC_HEADER = 24;
+constexpr size_t BEACON_FIXED = 12; // timestamp, interval, capability
+constexpr size_t SNIPPET = 0x62;
+constexpr uint16_t SNIPPETS_0_TO_8 = 0x1FF;
+constexpr uint64_t HOST_FORGET_MS = 5000;
+constexpr uint64_t HOST_SILENT_MS = 3000;
+constexpr uint32_t HEADER_SIZE = 0x160;
+constexpr size_t PAYLOAD_MAX = 504;
+constexpr uint32_t BINARY_MAX = 0x3BFE00;
+constexpr uint32_t ROM_MIN = 0x1000;
+constexpr int BEACONS_PER_ASK = 5;
+// Seen from a real Download Play client: the flags byte of each reply.
+constexpr uint8_t REPLY_FLAGS = 0x81;
+const uint8_t MP_CMD_MAC[6] = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x00};
+const uint8_t MP_REPLY_MAC[6] = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x10};
+
+uint16_t Le16(const uint8_t* p) noexcept { return p[0] | p[1] << 8; }
+uint32_t Le32(const uint8_t* p) noexcept { return Le16(p) | uint32_t(Le16(p + 2)) << 16; }
+void Put16(std::vector<uint8_t>& v, uint16_t x) { v.push_back(x & 0xFF); v.push_back(x >> 8); }
+void PutMac(std::vector<uint8_t>& v, const uint8_t* m) { v.insert(v.end(), m, m + 6); }
+
+/// [chars] UCS-2 characters, up to the first NUL, as UTF-8.
+std::string Ucs2(const uint8_t* p, size_t chars) {
+    std::string out;
+    for (size_t i = 0; i < chars; i++) {
+        const uint16_t c = Le16(p + i * 2);
+        if (c == 0) break;
+        if (c < 0x80) {
+            out += char(c);
+        } else if (c < 0x800) {
+            out += char(0xC0 | c >> 6);
+            out += char(0x80 | (c & 0x3F));
+        } else {
+            out += char(0xE0 | c >> 12);
+            out += char(0x80 | (c >> 6 & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        }
+    }
+    return out;
+}
+
+/// The Nintendo element's checksum over its entries 22h..87h.
+bool ChecksumOk(const uint8_t* dd) noexcept {
+    uint32_t sum = 0;
+    for (size_t i = 0x22; i < 0x88; i += 2) sum += Le16(dd + i);
+    return Le16(dd + 0x20) == (0xFFFF & ~(sum + (sum >> 16)));
+}
+
+// A host takes replies stamped no earlier than the end of its command's transmission (melonDS MP_RecvReplies): at
+// 2 Mbit/s 4 us a byte, plus preamble and the gap before replies.
+uint64_t ReplyTime(uint64_t cmdTimestamp, size_t cmdLen) noexcept { return cmdTimestamp + cmdLen * 4 + 96 + 112; }
+
+WmbMac MacAt(const uint8_t* p) noexcept {
+    WmbMac m;
+    std::copy_n(p, m.size(), m.begin());
+    return m;
+}
+}
+
+bool WmbScanner::FrameReceived(const uint8_t* frame, size_t len, uint64_t nowMs) noexcept {
+    const size_t ies = RX_HEADER + MAC_HEADER + BEACON_FIXED;
+    if (len < ies || frame[RX_HEADER] != 0x80 || frame[RX_HEADER + 1] != 0x00) return false;
+    const WmbMac host = MacAt(frame + RX_HEADER + 10);
+
+    for (size_t at = ies; at + 2 <= len;) {
+        const uint8_t tag = frame[at], size = frame[at + 1];
+        const uint8_t* dd = frame + at + 2;
+        at += 2 + size;
+        if (at > len) break;
+        if (tag != 0xDD || size < 0x88 || std::memcmp(dd, "\x00\x09\xBF\x00", 4) != 0) continue;
+        // GBATEK names beacon type 0Bh, but games send others (Mario Party DS: 03h): a Download Play beacon is told by its
+        // 70h bytes of advertisement repeating the game id, under a valid checksum.
+        if (dd[0x12] != 0x70 || Le32(dd + 0x18) != Le32(dd + 0x0C) || !ChecksumOk(dd)) return false;
+
+        const uint32_t gameId = Le32(dd + 0x0C);
+        const uint16_t stream = Le16(dd + 0x10);
+        Gathering& g = _gathering[host];
+        if (g.gameId != gameId || g.streamCode != stream) {
+            // A new upload: its advertisement is gathered afresh, and the old offer is no longer what the host sends.
+            g = Gathering {gameId, stream};
+            _offers.erase(host);
+        }
+        g.heardAt = nowMs;
+        const uint8_t snippet = dd[0x1F];
+        if (snippet == 9) {
+            // Lists the guests already in, not the offer: only their count is kept.
+            const uint8_t players = dd[0x22];
+            if (players == g.players) return false;
+            g.players = players;
+            const auto offer = _offers.find(host);
+            if (offer == _offers.end()) return false;
+            offer->second.players = players;
+            return true;
+        }
+        if (snippet > 8) return false;
+        const size_t snippetSize = std::min<size_t>(Le16(dd + 0x24), SNIPPET);
+        std::copy_n(dd + 0x26, snippetSize, g.data.begin() + snippet * SNIPPET);
+        const bool wasComplete = (g.have & SNIPPETS_0_TO_8) == SNIPPETS_0_TO_8;
+        g.have |= 1 << snippet;
+        if (wasComplete || (g.have & SNIPPETS_0_TO_8) != SNIPPETS_0_TO_8) return false;
+
+        const uint8_t* d = g.data.data();
+        WmbOffer offer;
+        offer.host = host;
+        offer.gameId = gameId;
+        offer.streamCode = stream;
+        offer.channel = frame[9];
+        offer.beaconInterval = Le16(frame + RX_HEADER + MAC_HEADER + 8);
+        offer.cmdDataSize = Le16(dd + 0x14);
+        std::copy_n(d, offer.icon.size(), offer.icon.begin());
+        offer.hostName = Ucs2(d + 0x222, std::min<size_t>(d[0x221], 10));
+        offer.players = g.players;
+        offer.maxPlayers = d[0x236];
+        offer.gameName = Ucs2(d + 0x238, 48);
+        offer.description = Ucs2(d + 0x298, 96);
+        _offers[host] = offer;
+        return true;
+    }
+    return false;
+}
+
+void WmbScanner::Forget(uint64_t nowMs) noexcept {
+    for (auto it = _gathering.begin(); it != _gathering.end();) {
+        if (nowMs - it->second.heardAt > HOST_FORGET_MS) {
+            _offers.erase(it->first);
+            it = _gathering.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+uint16_t WmbScanner::SnippetsHeard(const WmbMac& host) const noexcept {
+    const auto it = _gathering.find(host);
+    return it == _gathering.end() ? 0 : it->second.have;
+}
+
+void WmbClient::Start(const WmbOffer& offer, const WmbMac& mac, const std::u16string& username, uint64_t nowMs) noexcept {
+    *this = WmbClient {};
+    _offer = offer;
+    _mac = mac;
+    _username = username.substr(0, 10);
+    _payload = offer.cmdDataSize > 6 ? offer.cmdDataSize - 6 : 0;
+    // A data packet carries at most 504 bytes (GBATEK); anything else is not a host we can download from.
+    if (_payload == 0 || _payload > PAYLOAD_MAX) {
+        _state = State::Failed;
+        _failure = Failure::BadDownload;
+        return;
+    }
+    _state = State::Auth;
+    _beaconsSinceAsk = BEACONS_PER_ASK; // ask at the next beacon
+    _hostHeardAt = nowMs;
+}
+
+void WmbClient::Cancel() noexcept {
+    _state = State::Idle;
+}
+
+void WmbClient::Tick(uint64_t nowMs) noexcept {
+    const bool waiting = _state == State::Auth || _state == State::Assoc || _state == State::Download;
+    if (waiting && nowMs - _hostHeardAt > HOST_SILENT_MS) {
+        _state = State::Failed;
+        _failure = Failure::HostGone;
+    }
+}
+
+std::vector<uint8_t> WmbClient::Management(uint16_t fc, const std::vector<uint8_t>& body) noexcept {
+    std::vector<uint8_t> f(8, 0);
+    f.push_back(0x14);
+    f.push_back(_offer.channel);
+    Put16(f, 24 + body.size() + 4);
+    Put16(f, fc);
+    Put16(f, 0);
+    PutMac(f, _offer.host.data());
+    PutMac(f, _mac.data());
+    PutMac(f, _offer.host.data());
+    Put16(f, _seq++ << 4);
+    f.insert(f.end(), body.begin(), body.end());
+    f.insert(f.end(), 4, 0); // FCS: melonDS doesn't check it
+    return f;
+}
+
+std::vector<uint8_t> WmbClient::Reply(const uint8_t* cmdFrame, const std::array<uint8_t, 8>& body) noexcept {
+    std::vector<uint8_t> f(8, 0);
+    f.push_back(0x14);
+    f.push_back(cmdFrame[9]);
+    Put16(f, 24 + 10 + 4);
+    Put16(f, 0x0118);
+    Put16(f, 0);
+    PutMac(f, _offer.host.data());
+    PutMac(f, _mac.data());
+    PutMac(f, MP_REPLY_MAC);
+    Put16(f, _seq++ << 4);
+    f.push_back(4); // halfwords of reply data
+    f.push_back(REPLY_FLAGS);
+    f.insert(f.end(), body.begin(), body.end());
+    f.insert(f.end(), 4, 0);
+    return f;
+}
+
+uint32_t WmbClient::RegionSize(int region) const noexcept {
+    if (region == 0) return HEADER_SIZE;
+    return Le32(_rsa.data() + (region == 1 ? 0x24 : 0x34));
+}
+
+uint32_t WmbClient::RegionPackets(int region) const noexcept {
+    return _payload ? (uint64_t(RegionSize(region)) + _payload - 1) / _payload : 0;
+}
+
+uint32_t WmbClient::PacketsTotal() const noexcept {
+    if (!_haveRsa) return 0;
+    return RegionPackets(0) + RegionPackets(1) + RegionPackets(2);
+}
+
+std::vector<uint8_t> WmbClient::Region(int region) const noexcept {
+    if (!_haveRsa || region < 0 || region > 2) return {};
+    uint32_t first = 0;
+    for (int r = 0; r < region; r++) first += RegionPackets(r);
+    std::vector<uint8_t> out;
+    for (uint32_t n = first; n < first + RegionPackets(region); n++) {
+        const auto it = _packets.find(n);
+        if (it == _packets.end()) return {};
+        out.insert(out.end(), it->second.begin(), it->second.end());
+    }
+    out.resize(RegionSize(region));
+    return out;
+}
+
+std::array<uint8_t, 8> WmbClient::DataReply() const noexcept {
+    std::array<uint8_t, 8> reply {};
+    if (_packets.size() >= PacketsTotal()) {
+        reply[0] = 0x0A; // got all
+        return reply;
+    }
+    uint16_t next = 0;
+    while (_packets.count(next)) next++;
+    reply[0] = 0x09;
+    reply[1] = next & 0xFF;
+    reply[2] = next >> 8;
+    reply[3] = _packets.size() & 0xFF;
+    reply[4] = _packets.size() >> 8;
+    return reply;
+}
+
+void WmbClient::FrameReceived(const uint8_t* f, size_t len, uint64_t timestamp, bool cmd, uint64_t nowMs,
+                              std::vector<WmbOutgoing>& out) noexcept {
+    if (_state != State::Auth && _state != State::Assoc && _state != State::Download) return;
+    if (len < RX_HEADER + MAC_HEADER) return;
+    const uint8_t* mac = f + RX_HEADER;
+    const uint16_t fc = Le16(mac);
+    const uint8_t* body = mac + MAC_HEADER;
+    const size_t bodyLen = len - RX_HEADER - MAC_HEADER;
+    if (MacAt(mac + 10) != _offer.host) return;
+    _hostHeardAt = nowMs;
+    const bool toUs = MacAt(mac + 4) == _mac;
+
+    if (fc == 0x0080 && (_state == State::Auth || _state == State::Assoc)) {
+        // A host only listens for joiners right after its beacons: ask again then, until it answers.
+        if (++_beaconsSinceAsk < BEACONS_PER_ASK) return;
+        _beaconsSinceAsk = 0;
+        if (_state == State::Auth) {
+            out.push_back({Management(0x00B0, {0, 0, 1, 0, 0, 0}), timestamp});
+            return;
+        }
+        std::vector<uint8_t> b;
+        Put16(b, 0x0021); // capability
+        Put16(b, 0x0001); // listen interval
+        b.push_back(0x00);
+        b.push_back(0x20); // SSID: game id and stream code, zero-padded
+        for (int i = 0; i < 4; i++) b.push_back(_offer.gameId >> (8 * i));
+        Put16(b, _offer.streamCode);
+        b.insert(b.end(), 0x1A, 0);
+        b.insert(b.end(), {0x01, 0x02, 0x82, 0x84}); // rates
+        out.push_back({Management(0x0000, b), timestamp});
+        return;
+    }
+    if (fc == 0x00B0 && toUs && _state == State::Auth && bodyLen >= 6 && Le16(body + 2) == 2 && Le16(body + 4) == 0) {
+        _state = State::Assoc;
+        _beaconsSinceAsk = BEACONS_PER_ASK;
+        return;
+    }
+    if (fc == 0x0010 && toUs && _state == State::Assoc && bodyLen >= 6 && Le16(body + 2) == 0) {
+        _aid = Le16(body + 4) & 0x0F;
+        _state = State::Download;
+        return;
+    }
+    if (_state != State::Download || !cmd || fc != 0x0228 || std::memcmp(mac + 4, MP_CMD_MAC, 6) != 0 || bodyLen < 7) return;
+
+    std::array<uint8_t, 8> reply {};
+    switch (body[6]) {
+    case 0x01: { // NameRequest: the username in 6-byte snippets
+        reply[0] = 0x07;
+        reply[1] = _nameSnippet;
+        auto put = [&](int at, uint16_t x) { reply[at] = x & 0xFF; reply[at + 1] = x >> 8; };
+        auto ch = [&](size_t i) -> uint16_t { return i < _username.size() ? _username[i] : 0; };
+        if (_nameSnippet == 0) {
+            put(2, _offer.gameId & 0xFFFF);
+            put(4, _offer.gameId >> 16);
+            reply[6] = 0x0F; // favourite colour
+            reply[7] = _username.size();
+        } else if (_nameSnippet < 4) {
+            for (int i = 0; i < 3; i++) put(2 + i * 2, ch((_nameSnippet - 1) * 3 + i));
+        } else {
+            put(2, ch(9));
+            put(4, 0x0002);
+        }
+        _nameSnippet = (_nameSnippet + 1) % 5;
+        break;
+    }
+    case 0x03: // RSA frame: the binaries' addresses and sizes
+        if (!_haveRsa && bodyLen >= 7 + _rsa.size()) {
+            std::copy_n(body + 7, _rsa.size(), _rsa.begin());
+            _haveRsa = true;
+            // The binaries load into the DS's 4 MB of main RAM: larger sizes are forged, and would be allocated.
+            if (RegionSize(1) > BINARY_MAX || RegionSize(2) > BINARY_MAX) {
+                _haveRsa = false;
+                _state = State::Failed;
+                _failure = Failure::BadDownload;
+                return;
+            }
+        }
+        reply[0] = 0x08;
+        break;
+    case 0x04: { // Data
+        if (!_haveRsa || bodyLen < 11) break;
+        const uint16_t number = Le16(body + 9);
+        const size_t dataLen = std::min<size_t>({size_t(std::max(0, body[4] * 2 - 6)), bodyLen - 11, _payload});
+        if (number < PacketsTotal() && !_packets.count(number)) _packets[number].assign(body + 11, body + 11 + dataLen);
+        reply = DataReply();
+        break;
+    }
+    case 0x05: // Final
+        reply[0] = 0x0B;
+        out.push_back({Reply(f, reply), ReplyTime(timestamp, len), _aid, true});
+        out.push_back({Management(0x00C0, {3, 0}), ReplyTime(timestamp, len)});
+        if (_haveRsa && _packets.size() >= PacketsTotal()) {
+            _state = State::Done;
+        } else {
+            _state = State::Failed;
+            _failure = Failure::BadDownload;
+        }
+        return;
+    default: // nothing asked (00 after each phase): where this client stands, as a real client answers
+        if (_haveRsa && !_packets.empty()) reply = DataReply();
+        else if (_haveRsa) reply[0] = 0x08;
+        break;
+    }
+    out.push_back({Reply(f, reply), ReplyTime(timestamp, len), _aid, true});
+}
+
+std::array<uint8_t, 0x40> WmbClient::BootBlock() const noexcept {
+    std::array<uint8_t, 0x40> b {};
+    auto put16 = [&](size_t at, uint16_t x) { b[at] = x & 0xFF; b[at + 1] = x >> 8; };
+    put16(0x00, 2);      // booted from DS Download Play
+    put16(0x02, 0x60);   // beacon size
+    put16(0x04, 0x82);   // signal strength
+    std::copy(_offer.host.begin(), _offer.host.end(), b.begin() + 0x06);
+    put16(0x0C, 0x20);   // SSID size
+    put16(0x0E, _offer.gameId & 0xFFFF);
+    put16(0x10, _offer.gameId >> 16);
+    put16(0x12, _offer.streamCode);
+    put16(0x2E, 0x0021); // capability
+    put16(0x30, 0x0003); // rates
+    put16(0x32, 0x0003);
+    put16(0x34, _offer.beaconInterval);
+    put16(0x36, 0x0002); // TIM listen interval
+    put16(0x38, _offer.channel);
+    return b;
+}
+
+std::optional<WmbChild> MelonDsDs::MakeWmbChild(const std::vector<uint8_t>& header, const std::vector<uint8_t>& arm9,
+                                                const std::vector<uint8_t>& arm7, const std::array<uint8_t, 0x40>& bootBlock) noexcept {
+    if (header.size() < HEADER_SIZE) return std::nullopt;
+    const uint64_t arm9At = Le32(header.data() + 0x20), arm7At = Le32(header.data() + 0x30);
+    // A forged header could ask for gigabytes: the DS has 4 MB of main RAM, so its binaries sit well inside 32 MB.
+    constexpr uint64_t ROM_MAX = 32 << 20;
+    if (arm9At < HEADER_SIZE || arm7At < HEADER_SIZE || arm9At + arm9.size() > ROM_MAX || arm7At + arm7.size() > ROM_MAX)
+        return std::nullopt;
+    WmbChild child;
+    // melonDS refuses a cartridge image under 4 KB, which small binaries placed low would make.
+    child.rom.resize(std::max({arm9At + arm9.size(), arm7At + arm7.size(), uint64_t(ROM_MIN)}));
+    std::copy(header.begin(), header.end(), child.rom.begin());
+    std::copy(arm9.begin(), arm9.end(), child.rom.begin() + arm9At);
+    std::copy(arm7.begin(), arm7.end(), child.rom.begin() + arm7At);
+    child.bootBlock = bootBlock;
+    return child;
+}
diff --git a/src/libretro/net/wmb.hpp b/src/libretro/net/wmb.hpp
new file mode 100644
index 0000000..8a42045
--- /dev/null
+++ b/src/libretro/net/wmb.hpp
@@ -0,0 +1,117 @@
+#pragma once
+// DS Download Play (Wireless Multiboot) from the guest's side, per GBATEK "DS Wifi Nintendo Beacons" and "DS Wifi
+// Nintendo DS Download Play". Frames are melonDS's: a 12-byte radio header, then the 802.11 frame. Pure: no logging,
+// no clock of its own (the caller passes milliseconds), so it runs in host tests.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace MelonDsDs {
+using WmbMac = std::array<uint8_t, 6>;
+
+/// What a Download Play host offers, gathered from its beacons.
+struct WmbOffer {
+    WmbMac host {};
+    uint32_t gameId = 0;
+    uint16_t streamCode = 0;
+    std::string hostName;    // UTF-8
+    std::string gameName;    // UTF-8
+    std::string description; // UTF-8
+    uint8_t players = 0;     // in the session now, from snippet #9
+    uint8_t maxPlayers = 0;
+    uint8_t channel = 0;
+    uint16_t beaconInterval = 0;
+    uint16_t cmdDataSize = 0; // bytes per host command (Tag DDh [14h])
+    std::array<uint8_t, 0x220> icon {}; // palette (0x20) then 4bpp bitmap (0x200), as a cartridge icon
+};
+
+/// Gathers the advertisements of every Download Play host heard.
+class WmbScanner {
+public:
+    /// True when [frame] completed a host's offer or changed it.
+    bool FrameReceived(const uint8_t* frame, size_t len, uint64_t nowMs) noexcept;
+    const std::map<WmbMac, WmbOffer>& Offers() const noexcept { return _offers; }
+    /// Drops hosts not heard for a while: a host that quit takes its offer with it.
+    void Forget(uint64_t nowMs) noexcept;
+    /// Bit n: snippet n (0..8) of [host]'s current advertisement heard.
+    uint16_t SnippetsHeard(const WmbMac& host) const noexcept;
+private:
+    struct Gathering {
+        uint32_t gameId = 0;
+        uint16_t streamCode = 0;
+        uint16_t have = 0;
+        uint8_t players = 0;
+        uint64_t heardAt = 0;
+        std::array<uint8_t, 9 * 0x62> data {};
+    };
+    std::map<WmbMac, Gathering> _gathering;
+    std::map<WmbMac, WmbOffer> _offers;
+};
+
+/// One frame the client sends: melonDS's 12-byte TX header, then the 802.11 frame.
+struct WmbOutgoing {
+    std::vector<uint8_t> frame;
+    uint64_t timestamp = 0;
+    uint8_t aid = 0;
+    bool reply = false; // an MP reply to the host's command, else a plain frame (auth, assoc, deauth)
+};
+
+/// Joins one host's offer, answers its commands and collects the header, ARM9 and ARM7 it sends.
+class WmbClient {
+public:
+    enum class State { Idle, Auth, Assoc, Download, Done, Failed };
+    enum class Failure { None, HostGone, BadDownload };
+    /// [mac]: the console's own address, which the received game rejoins the host with.
+    void Start(const WmbOffer& offer, const WmbMac& mac, const std::u16string& username, uint64_t nowMs) noexcept;
+    /// Every received frame; what to send in answer goes to [out].
+    void FrameReceived(const uint8_t* frame, size_t len, uint64_t timestamp, bool cmd, uint64_t nowMs,
+                       std::vector<WmbOutgoing>& out) noexcept;
+    /// Gives up on a host that went silent.
+    void Tick(uint64_t nowMs) noexcept;
+    void Cancel() noexcept;
+    State GetState() const noexcept { return _state; }
+    Failure GetFailure() const noexcept { return _failure; }
+    const WmbOffer& Offer() const noexcept { return _offer; }
+    uint32_t PacketsDone() const noexcept { return _packets.size(); }
+    uint32_t PacketsTotal() const noexcept;
+    /// Done only: the region (0 header, 1 ARM9, 2 ARM7) as the host sent it; empty if a packet is missing.
+    std::vector<uint8_t> Region(int region) const noexcept;
+    /// What the DS menu leaves at 027FFC40 for a received game: how it came (Download Play) and the host to rejoin.
+    std::array<uint8_t, 0x40> BootBlock() const noexcept;
+private:
+    std::vector<uint8_t> Reply(const uint8_t* cmdFrame, const std::array<uint8_t, 8>& body) noexcept;
+    std::vector<uint8_t> Management(uint16_t fc, const std::vector<uint8_t>& body) noexcept;
+    std::array<uint8_t, 8> DataReply() const noexcept;
+    uint32_t RegionSize(int region) const noexcept;
+    uint32_t RegionPackets(int region) const noexcept;
+    State _state = State::Idle;
+    Failure _failure = Failure::None;
+    WmbOffer _offer;
+    WmbMac _mac {};
+    std::u16string _username;
+    uint16_t _seq = 0;
+    uint8_t _aid = 0;
+    uint8_t _nameSnippet = 0;
+    uint32_t _payload = 0;
+    bool _haveRsa = false;
+    std::array<uint8_t, 0xE4> _rsa {};
+    std::map<uint16_t, std::vector<uint8_t>> _packets;
+    int _beaconsSinceAsk = 0;
+    uint64_t _hostHeardAt = 0;
+};
+
+/// A received game as a cart would hold it, and the block to leave at 027FFC40.
+struct WmbChild {
+    std::vector<uint8_t> rom;
+    std::array<uint8_t, 0x40> bootBlock {};
+    WmbMac host {}; // the console that sent it
+};
+
+/// Each binary placed where the header says a cart holds it; nothing when the header is unusable.
+std::optional<WmbChild> MakeWmbChild(const std::vector<uint8_t>& header, const std::vector<uint8_t>& arm9,
+                                     const std::vector<uint8_t>& arm7, const std::array<uint8_t, 0x40>& bootBlock) noexcept;
+}
diff --git a/src/libretro/net/wmb_mailbox.h b/src/libretro/net/wmb_mailbox.h
new file mode 100644
index 0000000..f2188c9
--- /dev/null
+++ b/src/libretro/net/wmb_mailbox.h
@@ -0,0 +1,45 @@
+/*
+ * The block our DS Download Play client keeps in the DS's main RAM for the emulator's core, which runs the protocol:
+ * the core finds it by its magic, fills in the hosts it hears and how a download goes, and reads which host to join.
+ * The same file is in the core's patch (net/wmb_mailbox.h); a host test keeps the two identical. Little-endian, as
+ * the DS and the phones are.
+ */
+#ifndef NXDLP_MAILBOX_H
+#define NXDLP_MAILBOX_H
+
+#include <stdint.h>
+
+#define NXDLP_MAGIC "NXREDUX-DSDLP-1"
+#define NXDLP_OFFERS 8
+
+enum { NXDLP_NONE, NXDLP_SCANNING, NXDLP_JOINING, NXDLP_DOWNLOADING, NXDLP_BOOTING, NXDLP_FAILED };
+enum { NXDLP_OK, NXDLP_HOST_GONE, NXDLP_ROOM_LOST, NXDLP_BAD_DOWNLOAD };
+enum { NXDLP_CMD_NONE, NXDLP_CMD_JOIN, NXDLP_CMD_CANCEL };
+
+typedef struct {
+    uint8_t mac[6];
+    uint8_t players;
+    uint8_t maxPlayers;
+    uint16_t hostName[10];    /* UCS-2, NUL-terminated when shorter */
+    uint16_t gameName[48];    /* UCS-2, NUL-terminated */
+    uint16_t description[96]; /* UCS-2, NUL-terminated */
+    uint8_t icon[0x220];      /* palette, then 4bpp tiles, as a cartridge icon */
+} NxDlpOffer;
+
+typedef struct {
+    char magic[16];
+    /* Written by the core. */
+    uint32_t coreSeq;    /* bumped whenever the offers change */
+    uint32_t state;      /* NXDLP_SCANNING .. NXDLP_FAILED */
+    uint32_t reason;     /* with NXDLP_FAILED */
+    uint32_t done, total; /* packets, while downloading */
+    uint32_t offerCount;
+    NxDlpOffer offers[NXDLP_OFFERS];
+    /* Written by the client. */
+    uint32_t clientSeq;  /* bumped with each command */
+    uint32_t command;    /* NXDLP_CMD_JOIN (joinMac) or NXDLP_CMD_CANCEL */
+    uint8_t joinMac[6];
+    uint8_t pad[2];
+} NxDlpMailbox;
+
+#endif
diff --git a/src/libretro/net/wmb_session.cpp b/src/libretro/net/wmb_session.cpp
new file mode 100644
index 0000000..d24c158
--- /dev/null
+++ b/src/libretro/net/wmb_session.cpp
@@ -0,0 +1,164 @@
+#include "wmb_session.hpp"
+
+#include <cstring>
+#include <NDS.h>
+#include <SPI.h>
+
+using namespace MelonDsDs;
+
+namespace {
+// The mailbox is looked for once in a while until the client has put it in RAM; the scan is cheap but not free.
+constexpr uint32_t FIND_EVERY_FRAMES = 30;
+constexpr uint32_t BOX_ALIGN = 32;
+
+uint32_t Read32(const melonDS::NDS& console, uint32_t at) noexcept {
+    uint32_t v;
+    std::memcpy(&v, console.MainRAM + (at & console.MainRAMMask), sizeof(v));
+    return v;
+}
+
+void Write32(melonDS::NDS& console, uint32_t at, uint32_t v) noexcept {
+    std::memcpy(console.MainRAM + (at & console.MainRAMMask), &v, sizeof(v));
+}
+
+bool MagicAt(const melonDS::NDS& console, uint32_t at) noexcept {
+    return at + sizeof(NXDLP_MAGIC) <= console.MainRAMMask + 1 &&
+           std::memcmp(console.MainRAM + at, NXDLP_MAGIC, sizeof(NXDLP_MAGIC)) == 0;
+}
+
+#define BOX_FIELD(name) uint32_t(offsetof(NxDlpMailbox, name))
+}
+
+bool WmbSession::Busy() const noexcept {
+    const auto s = _client.GetState();
+    return s == WmbClient::State::Auth || s == WmbClient::State::Assoc || s == WmbClient::State::Download;
+}
+
+std::optional<WmbChild> WmbSession::TakeChild() noexcept {
+    auto child = std::move(_child);
+    _child.reset();
+    return child;
+}
+
+void WmbSession::BootFailed() noexcept {
+    _booting = false;
+    _client.Cancel();
+    _failedReason = NXDLP_BAD_DOWNLOAD;
+}
+
+void WmbSession::RoomStopped() noexcept {
+    if (Busy()) _roomLost = true;
+}
+
+void WmbSession::FrameReceived(const uint8_t* frame, size_t len, uint64_t timestamp, bool cmd, uint16_t sender,
+                               uint64_t nowMs, const Send& send) noexcept {
+    if (!_box) return;
+    if (_scanner.FrameReceived(frame, len, nowMs)) _offersChanged = true;
+    if (!Busy()) return;
+    if (len >= 12 + 16) {
+        WmbMac from;
+        std::copy_n(frame + 12 + 10, from.size(), from.begin());
+        if (from == _client.Offer().host) _hostSender = sender;
+    }
+    std::vector<WmbOutgoing> out;
+    _client.FrameReceived(frame, len, timestamp, cmd, nowMs, out);
+    for (const WmbOutgoing& o : out) send(o, _hostSender);
+}
+
+bool WmbSession::Frame(melonDS::NDS& console, uint64_t nowMs, const Send& send) noexcept {
+    (void)send;
+    if (!_box) {
+        if (_frames++ % FIND_EVERY_FRAMES != 0) return false;
+        for (uint32_t at = 0; at + sizeof(NxDlpMailbox) <= console.MainRAMMask + 1; at += BOX_ALIGN) {
+            if (MagicAt(console, at)) {
+                *this = WmbSession {};
+                _box = at;
+                _clientSeq = Read32(console, at + BOX_FIELD(clientSeq));
+                WriteState(console);
+                return true;
+            }
+        }
+        return false;
+    }
+    if (!MagicAt(console, *_box)) {
+        // The client is gone: the received game booted, or the console was reset.
+        *this = WmbSession {};
+        return false;
+    }
+
+    const uint32_t box = *_box;
+    const uint32_t clientSeq = Read32(console, box + BOX_FIELD(clientSeq));
+    if (clientSeq != _clientSeq) {
+        _clientSeq = clientSeq;
+        const uint32_t command = Read32(console, box + BOX_FIELD(command));
+        if (command == NXDLP_CMD_JOIN) {
+            WmbMac mac;
+            std::memcpy(mac.data(), console.MainRAM + ((box + BOX_FIELD(joinMac)) & console.MainRAMMask), mac.size());
+            const auto offer = _scanner.Offers().find(mac);
+            if (offer != _scanner.Offers().end()) {
+                const auto& fw = console.SPI.GetFirmware();
+                const auto& user = fw.GetEffectiveUserData();
+                const std::u16string name(user.Nickname, std::min<size_t>(user.NameLength, 10));
+                WmbMac own;
+                std::copy_n(fw.GetHeader().MacAddr.begin(), own.size(), own.begin());
+                _client.Start(offer->second, own, name, nowMs);
+                _failedReason = NXDLP_OK;
+                _roomLost = false;
+            }
+        } else if (command == NXDLP_CMD_CANCEL) {
+            _client.Cancel();
+            _failedReason = NXDLP_OK;
+        }
+    }
+
+    _client.Tick(nowMs);
+    if (_roomLost && Busy()) {
+        _client.Cancel();
+        _failedReason = NXDLP_ROOM_LOST;
+    }
+    _roomLost = false;
+    if (_client.GetState() == WmbClient::State::Failed && _failedReason == NXDLP_OK) {
+        _failedReason = _client.GetFailure() == WmbClient::Failure::HostGone ? NXDLP_HOST_GONE : NXDLP_BAD_DOWNLOAD;
+    }
+    if (_client.GetState() == WmbClient::State::Done && !_booting) {
+        _child = MakeWmbChild(_client.Region(0), _client.Region(1), _client.Region(2), _client.BootBlock());
+        if (_child) {
+            _child->host = _client.Offer().host;
+            _booting = true;
+        } else {
+            _client.Cancel(); // or the same download would be rebuilt every frame
+            _failedReason = NXDLP_BAD_DOWNLOAD;
+        }
+    }
+
+    const size_t before = _scanner.Offers().size();
+    _scanner.Forget(nowMs);
+    if (_scanner.Offers().size() != before) _offersChanged = true;
+    WriteState(console);
+    return false;
+}
+
+void WmbSession::WriteState(melonDS::NDS& console) noexcept {
+    const uint32_t box = *_box;
+    uint32_t state = NXDLP_SCANNING;
+    if (_booting) state = NXDLP_BOOTING;
+    else if (_failedReason != NXDLP_OK) state = NXDLP_FAILED;
+    else if (_client.GetState() == WmbClient::State::Download) state = NXDLP_DOWNLOADING;
+    else if (Busy()) state = NXDLP_JOINING;
+    Write32(console, box + BOX_FIELD(state), state);
+    Write32(console, box + BOX_FIELD(reason), state == NXDLP_FAILED ? _failedReason : NXDLP_OK);
+    Write32(console, box + BOX_FIELD(done), _client.PacketsDone());
+    Write32(console, box + BOX_FIELD(total), _client.PacketsTotal());
+    if (!_offersChanged) return;
+    _offersChanged = false;
+    uint32_t count = 0;
+    for (const auto& [mac, offer] : _scanner.Offers()) {
+        if (count == NXDLP_OFFERS) break;
+        NxDlpOffer o;
+        WriteOffer(offer, o);
+        std::memcpy(console.MainRAM + ((box + BOX_FIELD(offers) + count * sizeof(NxDlpOffer)) & console.MainRAMMask), &o, sizeof(o));
+        count++;
+    }
+    Write32(console, box + BOX_FIELD(offerCount), count);
+    Write32(console, box + BOX_FIELD(coreSeq), ++_coreSeq);
+}
diff --git a/src/libretro/net/wmb_session.hpp b/src/libretro/net/wmb_session.hpp
new file mode 100644
index 0000000..40ec635
--- /dev/null
+++ b/src/libretro/net/wmb_session.hpp
@@ -0,0 +1,76 @@
+#pragma once
+// A DS Download Play session for our client (tools/nds-download-play): the core finds the client's mailbox in the
+// DS's main RAM, lists the hosts it hears there, joins the one the client picks and hands back the received game.
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "wmb.hpp"
+#include "wmb_mailbox.h"
+
+namespace melonDS { class NDS; }
+
+namespace MelonDsDs {
+/// [offer] as the mailbox holds it: names in UCS-2, cut to fit with a NUL kept where there is room.
+inline void WriteOffer(const WmbOffer& offer, NxDlpOffer& box) noexcept {
+    box = NxDlpOffer {};
+    std::copy(offer.host.begin(), offer.host.end(), box.mac);
+    box.players = offer.players;
+    box.maxPlayers = offer.maxPlayers;
+    auto put = [](const std::string& utf8, uint16_t* out, size_t room, bool keepNul) {
+        size_t n = 0;
+        const size_t limit = keepNul ? room - 1 : room;
+        for (size_t i = 0; i < utf8.size() && n < limit;) {
+            const uint8_t c = utf8[i];
+            uint16_t ch;
+            if (c < 0x80) { ch = c; i += 1; }
+            else if ((c & 0xE0) == 0xC0 && i + 1 < utf8.size()) { ch = (c & 0x1F) << 6 | (utf8[i + 1] & 0x3F); i += 2; }
+            else if ((c & 0xF0) == 0xE0 && i + 2 < utf8.size()) {
+                ch = (c & 0x0F) << 12 | (utf8[i + 1] & 0x3F) << 6 | (utf8[i + 2] & 0x3F);
+                i += 3;
+            } else { ch = u'?'; i += 1; }
+            out[n++] = ch;
+        }
+    };
+    // A DS name fills all ten characters with no NUL, as the firmware stores it.
+    put(offer.hostName, box.hostName, 10, false);
+    put(offer.gameName, box.gameName, 48, true);
+    put(offer.description, box.description, 96, true);
+    std::copy(offer.icon.begin(), offer.icon.end(), box.icon);
+}
+
+class WmbSession {
+public:
+    /// Sends one frame into the room: a reply to the host, else to everyone.
+    using Send = std::function<void(const WmbOutgoing& frame, uint16_t host)>;
+    /// Once a frame, emulation thread. True when the mailbox was found this frame (the radio is to be reported on).
+    bool Frame(melonDS::NDS& console, uint64_t nowMs, const Send& send) noexcept;
+    /// Every room packet: [frame] is melonDS's radio header and the 802.11 frame; [sender] the room member it came from.
+    void FrameReceived(const uint8_t* frame, size_t len, uint64_t timestamp, bool cmd, uint16_t sender, uint64_t nowMs,
+                       const Send& send) noexcept;
+    /// The room session ended under a running download.
+    void RoomStopped() noexcept;
+    /// The client's mailbox is in RAM.
+    bool Active() const noexcept { return _box.has_value(); }
+    /// Joining or downloading: the host waits on each reply, so the room is read more often.
+    bool Busy() const noexcept;
+    std::optional<WmbChild> TakeChild() noexcept;
+    /// The received game could not be started: the client shows the download as failed.
+    void BootFailed() noexcept;
+private:
+    void WriteState(melonDS::NDS& console) noexcept;
+    std::optional<uint32_t> _box; // offset of the mailbox in main RAM
+    uint32_t _frames = 0;
+    uint32_t _clientSeq = 0;
+    uint32_t _coreSeq = 0;
+    uint32_t _failedReason = NXDLP_OK;
+    bool _offersChanged = false;
+    bool _roomLost = false;
+    uint16_t _hostSender = 0;
+    WmbScanner _scanner;
+    WmbClient _client;
+    std::optional<WmbChild> _child;
+    bool _booting = false;
+};
+}
