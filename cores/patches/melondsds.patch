+uint16_t Le16(const uint8_t* p) noexcept { return p[0] | p[1] << 8; }
+uint32_t Le32(const uint8_t* p) noexcept { return Le16(p) | uint32_t(Le16(p + 2)) << 16; }
+void Put16(std::vector<uint8_t>& v, uint16_t x) { v.push_back(x & 0xFF); v.push_back(x >> 8); }
+void PutMac(std::vector<uint8_t>& v, const uint8_t* m) { v.insert(v.end(), m, m + 6); }
+
+/// [chars] UCS-2 characters, up to the first NUL, as UTF-8.
+std::string Ucs2(const uint8_t* p, size_t chars) {
+    std::string out;
+    for (size_t i = 0; i < chars; i++) {
+        const uint16_t c = Le16(p + i * 2);
+        if (c == 0) break;
+        if (c < 0x80) {
+            out += char(c);
+        } else if (c < 0x800) {
+            out += char(0xC0 | c >> 6);
+            out += char(0x80 | (c & 0x3F));
+        } else {
+            out += char(0xE0 | c >> 12);
+            out += char(0x80 | (c >> 6 & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        }
+    }
+    return out;
