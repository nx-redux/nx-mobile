+bool MelonDsDs::IsDownloadPlayClient(std::span<const std::byte> rom) noexcept {
+    // Our client keeps the mailbox's magic as a constant; a game the size of a whole cart is not it.
+    constexpr size_t CLIENT_MAX = 4 << 20;
+    if (rom.size() > CLIENT_MAX) return false;
+    const auto* data = reinterpret_cast<const char*>(rom.data());
+    return std::search(data, data + rom.size(), NXDLP_MAGIC, NXDLP_MAGIC + sizeof(NXDLP_MAGIC)) != data + rom.size();
+}
+
+void MelonDsDs::CoreState::BootWmbChild(WmbChild child) noexcept {
+    auto cart = melonDS::NDSCart::ParseROM(child.rom.data(), child.rom.size(), nullptr, std::nullopt);
+    if (!cart) {
+        retro::warn("DS Download Play: the received game is not a ROM melonDS can load");
+        _mpState.WmbBootFailed();
+        return;
+    }
+    // First: the reset below powers the radio off, and the room must outlast it.
+    NdsDownloadPlayStarted();
+    MpState::GroupId own;
+    std::copy_n(Console->SPI.GetFirmware().GetHeader().MacAddr.begin(), own.size(), own.begin());
+    _mpState.DownloadPlayStarted(child.host, own);
+    // The player's JIT, but without fast memory: melonDS maps that only when it creates the console, and the client ran
+    // with the JIT off.
+    auto jit = JitArgs(Config);
+    if (jit) jit->FastMemory = false;
+    Console->SetJITArgs(jit);
+    Console->SetNDSCart(std::move(cart));
+    Console->Reset();
+    SetConsoleTime(*Console);
+    Console->SetupDirectBoot("download-play.nds");
