melonDS DS on GLES 3.2: lets the GL renderer build against GLES3 (with patches/melonds.patch on the melonDS
dependency), requests a GLES 3.2 context, ports the compositor shaders to GLSL ES 3.00, and turns face culling off
around the screen blit. Applied to cores/src/melondsds.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 30aefe1..be99ae4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,9 +77,7 @@ set(ENABLE_OGLRENDERER ${ENABLE_OPENGL})
 set(OPENGL_PROFILE ${DEFAULT_OPENGL_PROFILE} CACHE STRING "OpenGL profile to use if OpenGL is enabled. Valid values are 'OpenGL', 'OpenGLES2', 'OpenGLES3', 'OpenGLES31', and 'OpenGLES32'.")
 set_property(CACHE OPENGL_PROFILE PROPERTY STRINGS OpenGL OpenGLES2 OpenGLES3)
 
-if (ENABLE_OPENGL AND (NOT OPENGL_PROFILE STREQUAL "OpenGL"))
-    message(FATAL_ERROR "melonDS does not support OpenGL ES yet")
-endif()
+# GLES: melonDS carries the melonDS-android-lib GLES port (cores/patches/melonds.patch)
 
 if (APPLE)
     # Apple's OpenGL stops at 4.1, but melonDS's compute renderer needs 4.3
