+
+std::optional<Packet> MpState::TakeHostFarewell() noexcept {
+    if (_hostFrameHead.size() < FRAME_HEAD_LENGTH) {
+        return std::nullopt;
+    }
+    constexpr size_t MAC_LENGTH = 6;
+    constexpr size_t FRAME_LENGTH = 24 + 2 + 4;   // 802.11 header, reason code, checksum
+    std::vector<uint8_t> frame(RX_HEADER_LENGTH + FRAME_LENGTH, 0);
+    // Rate and channel as the host's last frame had them: melonDS drops a frame on another channel.
+    std::copy_n(_hostFrameHead.begin(), RX_HEADER_LENGTH, frame.begin());
+    frame[10] = FRAME_LENGTH & 0xFF;
+    frame[11] = FRAME_LENGTH >> 8;
+    uint8_t* dot11 = frame.data() + RX_HEADER_LENGTH;
+    dot11[0] = 0xC0;                                                      // deauthentication
+    std::fill_n(dot11 + 4, MAC_LENGTH, 0xFF);                             // to everyone
+    const uint8_t* hostMac = _hostFrameHead.data() + RX_HEADER_LENGTH + 10;
+    std::copy_n(hostMac, MAC_LENGTH, dot11 + 10);                         // from the host
+    std::copy_n(hostMac, MAC_LENGTH, dot11 + 16);                         // its group
+    dot11[24] = 3;                                                        // reason: the sender is leaving
+    const uint64_t timestamp = _hostTimestamp != 0 ? _hostTimestamp : 1;  // melonDS ignores a frame stamped 0
+    _hostFrameHead.clear();
+    return Packet(frame.data(), frame.size(), timestamp, 0, Packet::Type::Other);
+}
+
+bool MpState::AllPeersReplied(const std::vector<uint16_t> &replied) noexcept {
+    const auto cutoff = std::chrono::steady_clock::now() - std::chrono::milliseconds(PEER_FORGET_MS);
+    bool all = true;
+    for (auto it = _lastHeard.begin(); it != _lastHeard.end();) {
+        if (it->second < cutoff) {
+            it = _lastHeard.erase(it);
+            continue;
+        }
+        if (std::find(replied.begin(), replied.end(), it->first) == replied.end()) {
+            all = false;
+        }
+        ++it;
+    }
+    return all;
+}
