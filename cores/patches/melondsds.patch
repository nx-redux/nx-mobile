+        const size_t snippetSize = std::min<size_t>(Le16(dd + 0x24), SNIPPET);
+        std::copy_n(dd + 0x26, snippetSize, g.data.begin() + snippet * SNIPPET);
+        const bool wasComplete = (g.have & SNIPPETS_0_TO_8) == SNIPPETS_0_TO_8;
+        g.have |= 1 << snippet;
+        if (wasComplete || (g.have & SNIPPETS_0_TO_8) != SNIPPETS_0_TO_8) return false;
+
