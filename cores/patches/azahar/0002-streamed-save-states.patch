+/**
+ * A ZSTD frame of what [write] puts on its stream, compressed as it comes: the uncompressed data never sits in memory
+ * whole. [write] runs twice, first only to count the bytes, so the frame records its size as CompressDataZSTD's does.
+ * Empty on a failure.
+ */
+[[nodiscard]] std::vector<u8> CompressStreamZSTD(const std::function<void(std::ostream&)>& write,
+                                                 s32 compression_level);
+
+/** CompressStreamZSTD at ZSTD's default level, as CompressDataZSTDDefault. */
+[[nodiscard]] std::vector<u8> CompressStreamZSTDDefault(const std::function<void(std::ostream&)>& write);
+
+/** Hands [read] a stream of [compressed]'s data, decompressed as it is read; false when the frame is broken. */
+bool DecompressStreamZSTD(std::span<const u8> compressed,
+                          const std::function<void(std::istream&)>& read);
