 #include "common/zstd_compression.h"
 
 namespace Common::Compression {
+namespace {
+
+/** Counts what is written and keeps none of it. */
+class CountingBuf : public std::streambuf {
+public:
+    std::size_t count = 0;
+
+protected:
+    std::streamsize xsputn(const char*, std::streamsize n) override {
+        count += static_cast<std::size_t>(n);
+        return n;
+    }
+    int_type overflow(int_type c) override {
+        if (!traits_type::eq_int_type(c, traits_type::eof()))
+            ++count;
+        return traits_type::not_eof(c);
+    }
+};
+
+/** Compresses what is written into [out] in 1 MiB steps. */
+class CompressBuf : public std::streambuf {
+public:
+    CompressBuf(std::vector<u8>& out, std::size_t size, s32 level) : out{out}, input(1 << 20) {
+        ZSTD_CCtx_setParameter(ctx, ZSTD_c_compressionLevel, level);
+        ZSTD_CCtx_setPledgedSrcSize(ctx, size);
+        setp(input.data(), input.data() + input.size());
+    }
+    ~CompressBuf() override { ZSTD_freeCCtx(ctx); }
+
+    bool Finish() { return Drain(ZSTD_e_end); }
+
+protected:
+    int_type overflow(int_type c) override {
+        if (!Drain(ZSTD_e_continue))
+            return traits_type::eof();
+        if (!traits_type::eq_int_type(c, traits_type::eof())) {
+            *pptr() = traits_type::to_char_type(c);
+            pbump(1);
+        }
+        return traits_type::not_eof(c);
+    }
+
+private:
+    bool Drain(ZSTD_EndDirective mode) {
+        if (failed)
+            return false;
+        ZSTD_inBuffer in{input.data(), static_cast<std::size_t>(pptr() - pbase()), 0};
+        const std::size_t chunk = ZSTD_CStreamOutSize();
+        while (true) {
+            const std::size_t at = out.size();
+            out.resize(at + chunk);
+            ZSTD_outBuffer o{out.data() + at, chunk, 0};
+            const std::size_t left = ZSTD_compressStream2(ctx, &o, &in, mode);
+            out.resize(at + o.pos);
+            if (ZSTD_isError(left)) {
+                LOG_ERROR(Common, "Error compressing ZSTD stream: {}", ZSTD_getErrorName(left));
+                failed = true;
+                return false;
+            }
+            if (mode == ZSTD_e_end ? left == 0 : in.pos == in.size)
+                break;
+        }
+        setp(input.data(), input.data() + input.size());
+        return true;
+    }
+
+    std::vector<u8>& out;
+    std::vector<char> input;
+    ZSTD_CCtx* ctx = ZSTD_createCCtx();
+    bool failed = false;
+};
+
+/** Reads [compressed] decompressed, 1 MiB at a time. */
+class DecompressBuf : public std::streambuf {
+public:
+    explicit DecompressBuf(std::span<const u8> compressed)
+        : in{compressed.data(), compressed.size(), 0}, output(1 << 20) {
+        setg(output.data(), output.data(), output.data());
+    }
+    ~DecompressBuf() override { ZSTD_freeDCtx(ctx); }
+
+    bool failed = false;
+
+protected:
+    int_type underflow() override {
+        if (gptr() < egptr())
+            return traits_type::to_int_type(*gptr());
+        while (in.pos < in.size || !done) {
+            ZSTD_outBuffer o{output.data(), output.size(), 0};
+            const std::size_t left = ZSTD_decompressStream(ctx, &o, &in);
+            if (ZSTD_isError(left)) {
+                LOG_ERROR(Common, "Error decompressing ZSTD stream: {}", ZSTD_getErrorName(left));
+                failed = true;
+                return traits_type::eof();
+            }
+            done = left == 0;
+            if (o.pos > 0) {
+                setg(output.data(), output.data(), output.data() + o.pos);
+                return traits_type::to_int_type(*gptr());
+            }
+            if (in.pos == in.size)
+                break;
+        }
+        return traits_type::eof();
+    }
+
+private:
+    ZSTD_inBuffer in;
+    std::vector<char> output;
+    ZSTD_DCtx* ctx = ZSTD_createDCtx();
+    bool done = false;
+};
+
+} // namespace
+
+std::vector<u8> CompressStreamZSTD(const std::function<void(std::ostream&)>& write,
+                                   s32 compression_level) {
+    CountingBuf counter;
+    {
+        std::ostream counting{&counter};
+        write(counting);
+    }
+    std::vector<u8> out;
+    out.reserve(ZSTD_compressBound(counter.count) / 8);
+    CompressBuf compressor{out, counter.count,
+                           std::clamp(compression_level, ZSTD_minCLevel(), ZSTD_maxCLevel())};
+    {
+        std::ostream stream{&compressor};
+        write(stream);
+        stream.flush();
+    }
+    if (!compressor.Finish())
+        return {};
+    return out;
+}
+
+std::vector<u8> CompressStreamZSTDDefault(const std::function<void(std::ostream&)>& write) {
+    return CompressStreamZSTD(write, ZSTD_CLEVEL_DEFAULT);
+}
+
+bool DecompressStreamZSTD(std::span<const u8> compressed,
+                          const std::function<void(std::istream&)>& read) {
+    DecompressBuf buf{compressed};
+    std::istream stream{&buf};
+    read(stream);
+    return !buf.failed;
+}
