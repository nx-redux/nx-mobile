# NX Redux: read a ready-made GLideN64 hi-res pack (<ident>_HIRESTEXTURES.hts) through the frontend's VFS. The core
# takes the frontend's VFS interface, GLideN64 looks for the pack in the virtual folder /nx-vfs/hires (the app serves
# the user's file there from an open descriptor, so it works without All files access), and TxFileStorage reads it
# through libretro file streams instead of std::ifstream. Nothing exists at that path on disk, so GLideN64's
# clear-on-failed-load can never truncate the user's pack.
diff --git a/GLideN64/src/GLideNHQ/TxCache.cpp b/GLideN64/src/GLideNHQ/TxCache.cpp
index 8bea697..7c4b35a 100644
--- a/GLideN64/src/GLideNHQ/TxCache.cpp
+++ b/GLideN64/src/GLideNHQ/TxCache.cpp
@@ -37,6 +37,50 @@
 #include "TxCache.h"
 #include "TxDbg.h"
 
+#ifdef __LIBRETRO__
+#include <streams/file_stream.h>
+
+/* NX Redux: hi-res storage files are read through the frontend's VFS, so a pack the app hands over as a virtual file
+ * (an open descriptor from the user's ROMs folder) opens like one on disk. The std::ifstream calls TxFileStorage makes,
+ * on an RFILE. Writing is unchanged. */
+class TxInFile
+{
+public:
+	~TxInFile() { close(); }
+	void open(const std::string &path, std::ios_base::openmode)
+	{
+		close();
+		_file = filestream_open(path.c_str(), RETRO_VFS_FILE_ACCESS_READ, RETRO_VFS_FILE_ACCESS_HINT_NONE);
+		_good = _file != nullptr;
+	}
+	bool is_open() const { return _file != nullptr; }
+	void close()
+	{
+		if (_file != nullptr)
+			filestream_close(_file);
+		_file = nullptr;
+		_good = false;
+	}
+	bool good() const { return _good; }
+	TxInFile &read(char *s, int64 n)
+	{
+		if (!_good || filestream_read(_file, s, n) != n)
+			_good = false;
+		return *this;
+	}
+	TxInFile &seekg(int64 offset, std::ios_base::seekdir)
+	{
+		if (!_good || filestream_seek(_file, offset, RETRO_VFS_SEEK_POSITION_START) < 0)
+			_good = false;
+		return *this;
+	}
+
+private:
+	RFILE *_file = nullptr;
+	bool _good = false;
+};
+#endif
+
 #define TXCACHE_FORMAT_VERSION UNDEFINED_1
 
 class TxCacheImpl
@@ -563,7 +607,11 @@ private:
 	uint8 *_gzdest1 = nullptr;
 	uint32 _gzdestLen = 0;
 
+#ifdef __LIBRETRO__
+	TxInFile _infile;
+#else
 	std::ifstream _infile;
+#endif
 	std::ofstream _outfile;
 	int64 _storagePos = 0;
 	bool _dirty = false;
