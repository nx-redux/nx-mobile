+/* NX Redux: the native resolution factor for a window resized mid-game (libretro.c); the frame buffers GLideN64 rebuilds
+ * on the resize take it. */
+extern "C" void nx_gln64_set_native_res_factor(unsigned factor)
+{
+	config.frameBufferEmulation.nativeResFactor = factor;
+}
