+/* NX Redux: the app sets the 3D Resolution through the 4:3 Resolution's height (a multiple of 240 lines), for any
+ * aspect: a wide picture keeps its Wide Resolution's shape at that height. The size GLideN64's window draws at. */
+static bool nx_screen_size(uint32_t *width, uint32_t *height)
+{
+    struct retro_variable var;
+    unsigned w = 0, h = 0, wide_w = 0, wide_h = 0;
+
+    var.key = CORE_NAME "-43screensize";
+    var.value = NULL;
+    if (!environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) || !var.value || sscanf(var.value, "%ux%u", &w, &h) != 2 || !w || !h)
+        return false;
+    if (AspectRatio != 1)
+    {
+        var.key = CORE_NAME "-169screensize";
+        var.value = NULL;
+        if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value && sscanf(var.value, "%ux%u", &wide_w, &wide_h) == 2 && wide_h)
+            w = ((unsigned)((float)h * (float)wide_w / (float)wide_h + 0.5f) + 1u) & ~1u;
+        else
+            w = ((h * 16u / 9u) + 1u) & ~1u;
+    }
+    *width = w;
+    *height = h;
+    return true;
+}
+
+extern void gln64ResizeVideoOutput(int width, int height);
+extern void nx_gln64_set_native_res_factor(unsigned factor);
+
+/* NX Redux: a new 3D Resolution mid-game. GLideN64 rebuilds its frame buffers at the window's new size on its next VI
+ * update; the frontend learns the new frame size from the geometry. The smallest size draws with a native resolution
+ * factor of 1, as at launch. */
+static void nx_resize_live(void)
+{
+    uint32_t w = 0, h = 0;
+    struct retro_system_av_info info;
+
+    if (!emu_initialized || current_rdp_type != RDP_PLUGIN_GLIDEN64 || !nx_screen_size(&w, &h))
+        return;
+    if (w == retro_screen_width && h == retro_screen_height)
+        return;
+    retro_screen_width = w;
+    retro_screen_height = h;
+    if (AspectRatio != 1)
+        retro_screen_aspect = (float)w / (float)h;
+    EnableNativeResFactor = (w == 320 && h == 240) ? 1 : 0;
+    nx_gln64_set_native_res_factor(EnableNativeResFactor);
+    gln64ResizeVideoOutput((int)w, (int)h);
+    retro_get_system_av_info(&info);
+    environ_cb(RETRO_ENVIRONMENT_SET_GEOMETRY, &info.geometry);
+}
+
