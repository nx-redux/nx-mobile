 RETRO_API void retro_cheat_reset(void)
 {
+	if (s_frontend_patches.empty())
+		return;
+	s_frontend_patches.clear();
+	SendFrontendPatches();
 }
 
+// Only "patch:<group name>": turns that group of the game's patch files on or off. Cheats come
+// from the Enable Cheats option instead.
 RETRO_API void retro_cheat_set(unsigned index, bool enabled, const char* code)
 {
+	static constexpr std::string_view PREFIX = "patch:";
+	if (!code || std::strncmp(code, PREFIX.data(), PREFIX.size()) != 0)
+		return;
+	const std::string name(code + PREFIX.size());
+	const auto it = std::find(s_frontend_patches.begin(), s_frontend_patches.end(), name);
+	if (enabled == (it != s_frontend_patches.end()))
+		return;
+	if (enabled)
+		s_frontend_patches.push_back(name);
+	else
+		s_frontend_patches.erase(it);
+	SendFrontendPatches();
 }
 
