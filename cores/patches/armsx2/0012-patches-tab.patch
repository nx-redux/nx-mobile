+// Patch groups go to the CPU thread, which owns the patch lists; a vsync drains the queue.
+static void SendFrontendPatches()
+{
+	Host::RunOnCPUThread([names = s_frontend_patches]() mutable {
+		Patch::SetFrontendEnabledPatches(std::move(names));
+		Patch::UpdateActivePatches(true, false, true, true);
+	}, false);
