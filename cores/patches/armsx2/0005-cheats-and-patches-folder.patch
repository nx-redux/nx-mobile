+
+			// Cheats and patches from the user's folder beside the saves: a save
+			// directory <home>/Saves/<console> reads <home>/Cheats/<console> for
+			// .pnach cheats and its Patches/ subfolder for game patches (where the
+			// frontend puts PCSX2's patches.zip, extracted). Two folders, because
+			// the core reads the game's files in each as its own kind: patch files
+			// in the cheats folder would load as cheats too. Any other save
+			// directory keeps the defaults under the system directory.
+			std::string cheat_dir, patch_dir;
+			std::string_view saves(save_base);
+			while (saves.size() > 1 && saves.back() == '/')
+				saves.remove_suffix(1);
+			const std::string_view saves_parent = Path::GetDirectory(saves);
+			if (Path::GetFileName(saves_parent) == "Saves")
+			{
+				cheat_dir = Path::Combine(Path::Combine(Path::GetDirectory(saves_parent), "Cheats"), Path::GetFileName(saves));
+				patch_dir = Path::Combine(cheat_dir, "Patches");
+			}
+			{
+				auto lock = Host::GetSettingsLock();
+				s_base_settings->SetStringValue("Folders", "Cheats", cheat_dir.empty() ? "cheats" : cheat_dir.c_str());
+				s_base_settings->SetStringValue("Folders", "Patches", patch_dir.empty() ? "patches" : patch_dir.c_str());
+				// No per-cheat list to tick here: Enable Cheats turns on every cheat in the game's files.
+				s_base_settings->SetBoolValue("Cheats", "EnableAll", true);
+			}
+			if (!cheat_dir.empty())
+			{
+				EmuFolders::Cheats = cheat_dir;
+				EmuFolders::Patches = patch_dir;
+				log_cb(RETRO_LOG_INFO, "Cheats from %s, patches from %s\n", cheat_dir.c_str(), patch_dir.c_str());
+			}
 		}
 		else
 		{
