@@ -646,7 +645,19 @@ void Patch::ReloadEnabledLists()
 {
 	const std::vector<std::string> prev_enabled_cheats = std::move(s_enabled_cheats);
 	if (EmuConfig.EnableCheats && !Achievements::IsHardcoreModeActive())
+	{
 		s_enabled_cheats = Host::GetStringListSetting(CHEATS_CONFIG_SECTION, PATCH_ENABLE_CONFIG_KEY);
+		// A frontend with no list to tick cheats in (the libretro core) turns on every cheat in the
+		// game's files; unlabelled ones are on anyway.
+		if (Host::GetBoolSettingValue(CHEATS_CONFIG_SECTION, "EnableAll", false))
+		{
+			for (const PatchGroup& group : s_cheat_patches)
+			{
+				if (!group.name.empty() && std::find(s_enabled_cheats.begin(), s_enabled_cheats.end(), group.name) == s_enabled_cheats.end())
+					s_enabled_cheats.push_back(group.name);
+			}
+		}
+	}
 	else
 		s_enabled_cheats = {};
 
