+// CPU thread, between Execute() calls: the only place where pausing the VM
+// really means nothing more reaches the GS.
+void LibretroCore::ServiceGLContextRequests()
+{
+	if (s_gl_release_requested.load(std::memory_order_acquire))
+	{
+		if (VMManager::GetState() == VMState::Running)
+		{
+			VMManager::SetState(VMState::Paused);
+			s_gl_paused_vm = true;
+		}
+		if (MTGS::IsOpen())
+		{
+			MTGS::RunOnGSThread([]() {
+				if (!g_gs_device || g_gs_device->GetRenderAPI() != RenderAPI::OpenGL)
+					return;
+				// Draw what the GS has batched while there is a context to draw
+				// it with; otherwise the rebuild's own flush would draw it into
+				// the abandoned device.
+				if (g_gs_renderer)
+					g_gs_renderer->Flush(GSState::GSFlushReason::GSREOPEN);
+				static_cast<GSDeviceOGL*>(g_gs_device.get())->AbandonContext(true);
+				s_gl_abandoned.store(true, std::memory_order_release);
+			});
+			MTGS::WaitGS(false);
+		}
+		s_gl_release_requested.store(false, std::memory_order_release);
+	}
+
+	if (s_gl_rebuild_requested.exchange(false, std::memory_order_acq_rel))
+	{
+		if (s_gl_abandoned.load(std::memory_order_acquire) && MTGS::IsOpen())
+		{
+			// The device-loss arm of GSreopen: keep the renderer and its GS
+			// memory, purge the textures that died with the context, and open
+			// a new device, which shares the context the frontend just handed
+			// over. A failed open leaves the device abandoned and the VM paused:
+			// a still picture rather than a crash.
+			bool ok = false;
+			MTGS::RunOnGSThread([&ok]() {
+				ok = GSreopen(true, false, GSGetCurrentRenderer(), std::nullopt);
+			});
+			MTGS::WaitGS(false);
+			if (ok)
+				s_gl_abandoned.store(false, std::memory_order_release);
+			else
+				Console.Error("Could not rebuild the GS device after a GL context loss.");
+		}
+		if (s_gl_paused_vm && !s_gl_abandoned.load(std::memory_order_acquire))
+		{
+			s_gl_paused_vm = false;
+			if (VMManager::GetState() == VMState::Paused)
+				VMManager::SetState(VMState::Running);
+		}
+	}
+}
 #endif // ENABLE_OPENGL
 
