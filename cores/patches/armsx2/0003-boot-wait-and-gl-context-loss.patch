+
+// Waits for a VM boot that is still under way, for a state load that arrives
+// before the VM exists (the frontend's first frame comes before the boot ends).
+// Runs on the frontend's thread, inside retro_unserialize, with pacing already
+// off. That cannot deadlock: nothing the boot does needs this thread. The GS
+// device opens on the GS thread against the context context_reset captured
+// earlier (GL) or the device create_device negotiated (Vulkan), and with
+// pacing off no present parks the GS thread on a retro_run. Only waits while a
+// boot can still finish: the CPU thread is up, the context is there (the boot
+// is parked on it otherwise) and nothing asked for a shutdown.
+//
+// 30 seconds: a boot on a phone takes a few (BIOS, disc and GS device, shader
+// cache misses included); anything far past that is a boot that is not going
+// to end, and the frontend's thread must not hang on it.
+bool LibretroCore::WaitForPendingBoot()
+{
+	const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+	while (!VMManager::HasValidVM() && s_boot_pending.load(std::memory_order_acquire) &&
+		   s_vm_thread_running.load(std::memory_order_acquire) &&
+		   s_context_ready.load(std::memory_order_acquire) &&
+		   !s_shutdown_requested.load(std::memory_order_acquire) &&
+		   std::chrono::steady_clock::now() < deadline)
+	{
+		std::this_thread::sleep_for(std::chrono::milliseconds(2));
+	}
+	return VMManager::HasValidVM();
 }
 
