@@ -0,0 +1,59 @@
+// Copyright (c) 2012- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+// The ad hoc link to the nx-mobile frontend (libretro/nx_psp_link.h). The frontend finds the other devices and
+// chooses which one runs the ad hoc server; the core takes its server from it and runs this device's when told.
+// Without a frontend that answers, Enabled() is false and nothing here changes what the core does.
+
+#pragma once
+
+#include <cstdint>
+
+namespace NxPspLink {
+
+// retro_environment_t, without pulling libretro.h into the HLE.
+typedef bool (*EnvironmentCallback)(unsigned cmd, void *data);
+
+bool Enabled();
+// Before the PSP boots, so the forced settings are in place for __NetInit.
+void Register(EnvironmentCallback environment);
+// Before the PSP shuts down. Also stops a server the frontend started.
+void Unregister();
+
+// The server to log in to and this device's address on its network, both network order. Blocks up to about
+// 1.2 s while the frontend listens for one, so only from the login thread. False: none this time.
+bool Server(uint32_t *ip, uint32_t *self);
+// The game reached Scan / Create / Connect / Join, is in a group, or left ad hoc. Only changes reach the frontend.
+void Active(bool active, bool grouped);
+// The poll's view of the group, reported while the game is in ad hoc.
+void Grouped(bool grouped);
+bool InAdhoc();
+void RouteSocket(int fd);
+// The address last given by Server(); 0 before.
+uint32_t SelfIp();
+// The frontend asked for a new login since the last call.
+bool TakeRelogin();
+
+// adhocServerThread is started and stopped from the frontend's thread too, so boot and shutdown go through these.
+void StopServer();
+// At boot and after a reset: stops the server, runs init (__AdhocServerInit, whose tables the server reads), and
+// starts it again if the frontend still counts on it, all without letting serve() in between.
+void ResetServer(void (*init)());
+// From the server thread, once it listens or has given up.
+void ServerReady();
+
+}  // namespace NxPspLink
