+// The server can change between logins, so it's asked for each time. None leaves INADDR_NONE, and this login
+// gives up without connecting.
+static void TakeAdhocServerFromLink() {
+	uint32_t ip = 0;
+	uint32_t self = 0;
+	const bool chosen = NxPspLink::Server(&ip, &self);
+	{
+		const std::lock_guard<std::mutex> adhoc_server_ip_guard(g_adhocServerIPMutex);
+		g_adhocServerIP.in.sin_family = AF_INET;
+		g_adhocServerIP.in.sin_addr.s_addr = chosen ? ip : INADDR_NONE;
+		g_adhocServerIP.in.sin_port = htons(SERVER_PORT);
+	}
+	clearLocalIpCache();
+	if (!chosen) {
+		INFO_LOG(Log::sceNet, "FriendFinder: no ad hoc server from the link this time");
+	}
+}
