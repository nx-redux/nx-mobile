new file mode 100644
index 0000000..1d998e4
--- /dev/null
+++ b/Core/HLE/NxPspLink.cpp
@@ -0,0 +1,232 @@
+// Copyright (c) 2012- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include "Common/Log.h"
+#include "Core/HLE/NxPspLink.h"
+#include "Core/HLE/proAdhoc.h"
+#include "Core/HLE/proAdhocServer.h"
+#include "libretro/nx_psp_link.h"
+
+namespace NxPspLink {
+
+// The frontend's presence numbering (nx_3ds_link.h).
+static const int PRESENCE_OUT = 0;
+// Binding is quick; this only bounds serve(1) if the thread never gets that far.
+static const int SERVER_READY_TIMEOUT_MS = 2000;
+
+static EnvironmentCallback environment = nullptr;
+// The frontend fills in its half during the SET. Unregister() leaves it, so a thread that saw Enabled() just
+// before still calls a valid function (which answers "none" once the frontend has let go of the core).
+static nx_psp_link_interface iface;
+static std::atomic<bool> enabled(false);
+static std::atomic<uint32_t> selfIp(0);
+// What the frontend was last told: 0 out of ad hoc, 1 in ad hoc, 2 in a group.
+static std::atomic<int> reported(0);
+static std::atomic<bool> reloginPending(false);
+
+// Held only to start or stop adhocServerThread, never while calling the frontend.
+static std::mutex serverMutex;
+static bool serveWanted = false;
+static std::mutex readyMutex;
+static std::condition_variable readyCond;
+static bool serverReady = false;
+
+static void StopServerLocked() {
+	adhocServerRunning = false;
+	if (adhocServerThread.joinable()) {
+		adhocServerThread.join();
+	}
+}
+
+static void StartServerLocked() {
+	if (adhocServerThread.joinable()) {
+		if (adhocServerRunning) {
+			return;
+		}
+		// It ended by itself (its port was taken).
+		adhocServerThread.join();
+	}
+	{
+		std::lock_guard<std::mutex> guard(readyMutex);
+		serverReady = false;
+	}
+	// Set here rather than by the thread, as __NetAdhocInit does, so a stop that comes first can't be undone.
+	adhocServerRunning = true;
+	adhocServerThread = std::thread(proAdhocServerThread, SERVER_PORT);
+	std::unique_lock<std::mutex> lock(readyMutex);
+	readyCond.wait_for(lock, std::chrono::milliseconds(SERVER_READY_TIMEOUT_MS), [] { return serverReady; });
+}
+
+static int LinkPresence() {
+	return PRESENCE_OUT;
+}
+
+static void LinkLeave() {
+}
+
+static void LinkRejoin() {
+}
+
+// From the frontend's finder thread, which unload joins: waits for nothing but the server thread.
+static void LinkServe(int on) {
+	std::lock_guard<std::mutex> guard(serverMutex);
+	serveWanted = on != 0;
+	if (on) {
+		StartServerLocked();
+	} else {
+		StopServerLocked();
+	}
+	INFO_LOG(Log::sceNet, "NxPspLink: server %s", on ? "on" : "off");
+}
+
+// From the frontend's finder thread. The poll, on the CPU thread, drops the connection and logs in again.
+static void LinkRelogin() {
+	reloginPending = true;
+	INFO_LOG(Log::sceNet, "NxPspLink: log in again");
+}
+
+bool Enabled() {
+	return enabled;
+}
+
+void Register(EnvironmentCallback env) {
+	if (enabled || !env) {
+		return;
+	}
+	iface = nx_psp_link_interface{};
+	iface.presence = LinkPresence;
+	iface.leave = LinkLeave;
+	iface.rejoin = LinkRejoin;
+	iface.serve = LinkServe;
+	iface.relogin = LinkRelogin;
+	selfIp = 0;
+	reported = 0;
+	reloginPending = false;
+	environment = env;
+	// Set before the call: the frontend may call serve() from its own thread before the call returns, and the
+	// server thread then skips its probe for another server.
+	enabled = true;
+	if (!env(NX_ENVIRONMENT_SET_PSP_LINK, &iface)) {
+		// A frontend that doesn't answer never calls serve().
+		enabled = false;
+		return;
+	}
+	if (!iface.server || !iface.active) {
+		ERROR_LOG(Log::sceNet, "NxPspLink: the frontend's half is missing");
+		Unregister();
+		return;
+	}
+	INFO_LOG(Log::sceNet, "NxPspLink: registered");
+}
+
+void Unregister() {
+	if (!enabled) {
+		return;
+	}
+	// Under no lock of ours: the frontend joins its finder thread here, which may be in serve() or relogin().
+	// Still enabled meanwhile, so a server that thread starts skips the probe; the frontend's calls are safe
+	// throughout and answer "none" once it has let go of the core.
+	environment(NX_ENVIRONMENT_SET_PSP_LINK, nullptr);
+	enabled = false;
+	{
+		std::lock_guard<std::mutex> guard(serverMutex);
+		serveWanted = false;
+		StopServerLocked();
+	}
+	reported = 0;
+	reloginPending = false;
+	INFO_LOG(Log::sceNet, "NxPspLink: unregistered");
+}
+
+bool Server(uint32_t *ip, uint32_t *self) {
+	if (!enabled) {
+		return false;
+	}
+	uint32_t serverIp = 0;
+	uint32_t selfAddr = 0;
+	if (!iface.server(&serverIp, &selfAddr)) {
+		return false;
+	}
+	selfIp = selfAddr;
+	*ip = serverIp;
+	*self = selfAddr;
+	return true;
+}
+
+void Active(bool active, bool grouped) {
+	if (!enabled) {
+		return;
+	}
+	const int state = !active ? 0 : grouped ? 2 : 1;
+	if (reported.exchange(state) == state) {
+		return;
+	}
+	iface.active(active ? 1 : 0, state == 2 ? 1 : 0);
+}
+
+void Grouped(bool grouped) {
+	if (enabled && reported != 0) {
+		Active(true, grouped);
+	}
+}
+
+bool InAdhoc() {
+	return enabled && reported != 0;
+}
+
+void RouteSocket(int fd) {
+	if (enabled && iface.route_socket) {
+		iface.route_socket(fd, 0);
+	}
+}
+
+uint32_t SelfIp() {
+	return selfIp;
+}
+
+bool TakeRelogin() {
+	return enabled && reloginPending.exchange(false);
+}
+
+void StopServer() {
+	std::lock_guard<std::mutex> guard(serverMutex);
+	StopServerLocked();
+}
+
+void ResetServer(void (*init)()) {
+	// One hold for the three steps: a serve(1) in between would start a server reading the tables init replaces.
+	std::lock_guard<std::mutex> guard(serverMutex);
+	StopServerLocked();
+	init();
+	if (enabled && serveWanted) {
+		StartServerLocked();
+	}
+}
+
+void ServerReady() {
+	std::lock_guard<std::mutex> guard(readyMutex);
+	serverReady = true;
+	readyCond.notify_all();
+}
+
+}  // namespace NxPspLink
