+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+// The ad hoc link to the nx-mobile frontend (libretro/nx_psp_link.h). The frontend finds the other devices and
+// chooses which one runs the ad hoc server; the core takes its server from it and runs this device's when told.
+// Without a frontend that answers, Enabled() is false and nothing here changes what the core does.
+
+#pragma once
+
+#include <cstdint>
+
+namespace NxPspLink {
+
+// retro_environment_t, without pulling libretro.h into the HLE.
+typedef bool (*EnvironmentCallback)(unsigned cmd, void *data);
+
+bool Enabled();
+// Before the PSP boots, so the forced settings are in place for __NetInit.
+void Register(EnvironmentCallback environment);
+// Before the PSP shuts down. Also stops a server the frontend started.
+void Unregister();
+
+// The server to log in to and this device's address on its network, both network order. Blocks up to about
+// 1.5 s while the frontend listens for one, so only from the login thread. False: none this time.
+bool Server(uint32_t *ip, uint32_t *self);
+// The game reached Scan / Create / Connect / Join, is in a group, or left ad hoc. What the frontend is told also
+// carries whether this device's server has another user (ServerUsers); only changes reach it.
+void Active(bool active, bool grouped);
+// The poll's view of the group, reported while the game is in ad hoc.
+void Grouped(bool grouped);
+bool InAdhoc();
+void RouteSocket(int fd);
+// The address last given by Server(); 0 before.
+uint32_t SelfIp();
+// The frontend asked for a new login since the last call.
+bool TakeRelogin();
+
+// The frontend's presence numbering (nx_3ds_link.h): 0 out of ad hoc or left, 1 looking, 2 in a group. Any thread.
+int Presence();
+// The game should be off the server: the frontend's leave() has not been undone by rejoin() or, on the automatic
+// route, by the game leaving ad hoc and coming back. Any thread.
+bool Parked();
+// From check_variables, the route nx_psp_link names: the automatic route comes back after a leave when the game
+// re-enters ad hoc, a session's by rejoin(), as the frontend does; a link switched off never comes back. A session
+// turned into the automatic route arrives parked (the frontend's leave() comes first) and comes back by that rule.
+enum Route { ROUTE_AUTO, ROUTE_SESSION, ROUTE_OFF };
+void SetRoute(Route route);
+// For the poll, which does on the CPU thread what leave() and rejoin() ask from other threads.
+bool TakeLeave();
+bool TakeRejoin();
+// The connection to the server was lost (killAdhocctlClient due to an error), on whatever thread noticed it.
+void ServerLost();
+bool TakeServerLost();
+
+// adhocServerThread is started and stopped from the frontend's thread too, so boot and shutdown go through these.
+void StopServer();
+// At boot and after a reset: stops the server, runs init (__AdhocServerInit, whose tables the server reads), and
+// starts it again if the frontend still counts on it, all without letting serve() in between.
+void ResetServer(void (*init)());
+// From the server thread, once it listens or has given up.
+void ServerReady();
+// From the server thread, whenever its users change: whether a device other than this one is on it. The frontend
+// keeps such a server (it neither hands over nor stops it), even after this device's game left ad hoc.
+void ServerUsers(bool others);
+
+}  // namespace NxPspLink
+
+// ext/CMakeLists.txt builds aemu_postoffice's sock_impl_linux.c with socket() renamed to this, so the connection to
+// the ad hoc server, which that library opens, is routed before it connects.
+extern "C" int NxPspLinkClientSocket(int domain, int type, int protocol);
