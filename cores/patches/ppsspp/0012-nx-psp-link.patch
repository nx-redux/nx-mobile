diff --git a/Core/HLE/NxPspLink.cpp b/Core/HLE/NxPspLink.cpp
new file mode 100644
index 0000000..04287d2
--- /dev/null
+++ b/Core/HLE/NxPspLink.cpp
@@ -0,0 +1,397 @@
+// Copyright (c) 2012- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include "Common/Log.h"
+#include "Common/Net/SocketCompat.h"
+#include "Core/HLE/NxPspLink.h"
+#include "Core/HLE/proAdhoc.h"
+#include "Core/HLE/proAdhocServer.h"
+#include "libretro/nx_psp_link.h"
+
+namespace NxPspLink {
+
+// The frontend's presence numbering (nx_3ds_link.h).
+static const int PRESENCE_OUT = 0;
+static const int PRESENCE_SEEKING = 1;
+static const int PRESENCE_ROOM = 2;
+// Binding is quick; this only bounds serve(1) if the thread never gets that far.
+static const int SERVER_READY_TIMEOUT_MS = 2000;
+
+static EnvironmentCallback environment = nullptr;
+// The frontend fills in its half during the SET. Unregister() leaves it, so a thread that saw Enabled() just
+// before still calls a valid function (which answers "none" once the frontend has let go of the core).
+static nx_psp_link_interface iface;
+static std::atomic<bool> enabled(false);
+static std::atomic<uint32_t> selfIp(0);
+// What the frontend was last told: 0 out of ad hoc, 1 in ad hoc, 2 in a group.
+static std::atomic<int> reported(0);
+static std::atomic<bool> reloginPending(false);
+static std::atomic<bool> leavePending(false);
+static std::atomic<bool> rejoinPending(false);
+static std::atomic<bool> serverLost(false);
+
+// The frontend parks its election on leave() and brings it back on the same terms (psplinkhooks.cpp: adapterLeave,
+// adapterRejoin, coreActiveReport); these follow it. Held only for a few assignments, never while calling the
+// frontend, so leave() and rejoin(), which the frontend calls holding its own lock, never wait on anything here.
+static std::mutex parkMutex;
+static std::atomic<bool> parked(false);
+// While parked: the game has been out of ad hoc since the leave, so on the automatic route its next trigger brings it
+// back. Kept on a session too: the frontend can turn a session into the automatic route after its leave, and reads the
+// new route a frame before this core does.
+static bool outSinceLeave = false;
+static std::atomic<int> route(ROUTE_AUTO);
+
+// Kept by the server thread (ServerUsers), read by whoever reports.
+static std::atomic<bool> serverUsers(false);
+// The CPU thread and the server thread both report to the frontend; one at a time, each from the latest state, so the
+// last report is never a stale one. Held while calling the frontend's active(), which takes only the frontend's own
+// lock and never calls back into the core; nothing else is taken under it.
+static std::mutex reportMutex;
+static int sentActive = 0;
+static int sentGrouped = 0;
+
+// Held only to start or stop adhocServerThread, never while calling the frontend.
+static std::mutex serverMutex;
+static bool serveWanted = false;
+static std::mutex readyMutex;
+static std::condition_variable readyCond;
+static bool serverReady = false;
+
+static void StopServerLocked() {
+	adhocServerRunning = false;
+	if (adhocServerThread.joinable()) {
+		adhocServerThread.join();
+	}
+	// Not reported from here (the frontend is never called under serverMutex): the frontend only weighs it while
+	// serving, and the poll's next report, or a new server's first, carries it.
+	serverUsers = false;
+}
+
+static void Report() {
+	std::lock_guard<std::mutex> guard(reportMutex);
+	const int active = reported != 0 ? 1 : 0;
+	const int grouped = reported == 2 || serverUsers ? 1 : 0;
+	if (active == sentActive && grouped == sentGrouped) {
+		return;
+	}
+	sentActive = active;
+	sentGrouped = grouped;
+	iface.active(active, grouped);
+}
+
+static void StartServerLocked() {
+	if (adhocServerThread.joinable()) {
+		if (adhocServerRunning) {
+			return;
+		}
+		// It ended by itself (its port was taken).
+		adhocServerThread.join();
+	}
+	{
+		std::lock_guard<std::mutex> guard(readyMutex);
+		serverReady = false;
+	}
+	// Set here rather than by the thread, as __NetAdhocInit does, so a stop that comes first can't be undone.
+	adhocServerRunning = true;
+	adhocServerThread = std::thread(proAdhocServerThread, SERVER_PORT);
+	std::unique_lock<std::mutex> lock(readyMutex);
+	readyCond.wait_for(lock, std::chrono::milliseconds(SERVER_READY_TIMEOUT_MS), [] { return serverReady; });
+}
+
+static int LinkPresence() {
+	return Presence();
+}
+
+// From the frontend's UI thread, with its lock held and the emulation perhaps paused: only flags, and no log (which
+// goes to the frontend). The poll tells the game and drops the server connection when the game next runs; the
+// frontend stops this device's server itself.
+static void LinkLeave() {
+	std::lock_guard<std::mutex> guard(parkMutex);
+	parked = true;
+	outSinceLeave = reported == 0;
+	rejoinPending = false;
+	leavePending = true;
+}
+
+// The frontend calls this on every return to the foreground; only a session comes back by it.
+static void LinkRejoin() {
+	std::lock_guard<std::mutex> guard(parkMutex);
+	if (!parked || route != ROUTE_SESSION) {
+		return;
+	}
+	parked = false;
+	rejoinPending = true;
+}
+
+// From the frontend's finder thread, which unload joins: waits for nothing but the server thread.
+static void LinkServe(int on) {
+	std::lock_guard<std::mutex> guard(serverMutex);
+	serveWanted = on != 0;
+	if (on) {
+		StartServerLocked();
+	} else {
+		StopServerLocked();
+	}
+	INFO_LOG(Log::sceNet, "NxPspLink: server %s", on ? "on" : "off");
+}
+
+// From the frontend's finder thread. The poll, on the CPU thread, drops the connection and logs in again.
+static void LinkRelogin() {
+	reloginPending = true;
+	INFO_LOG(Log::sceNet, "NxPspLink: log in again");
+}
+
+bool Enabled() {
+	return enabled;
+}
+
+void Register(EnvironmentCallback env) {
+	if (enabled || !env) {
+		return;
+	}
+	iface = nx_psp_link_interface{};
+	iface.presence = LinkPresence;
+	iface.leave = LinkLeave;
+	iface.rejoin = LinkRejoin;
+	iface.serve = LinkServe;
+	iface.relogin = LinkRelogin;
+	selfIp = 0;
+	reported = 0;
+	serverUsers = false;
+	{
+		std::lock_guard<std::mutex> guard(reportMutex);
+		sentActive = 0;
+		sentGrouped = 0;
+	}
+	reloginPending = false;
+	leavePending = false;
+	rejoinPending = false;
+	serverLost = false;
+	{
+		std::lock_guard<std::mutex> guard(parkMutex);
+		parked = false;
+		outSinceLeave = false;
+	}
+	environment = env;
+	// Set before the call: the frontend may call serve() from its own thread before the call returns, and the
+	// server thread then skips its probe for another server.
+	enabled = true;
+	if (!env(NX_ENVIRONMENT_SET_PSP_LINK, &iface)) {
+		// A frontend that doesn't answer never calls serve().
+		enabled = false;
+		return;
+	}
+	if (!iface.server || !iface.active) {
+		ERROR_LOG(Log::sceNet, "NxPspLink: the frontend's half is missing");
+		Unregister();
+		return;
+	}
+	INFO_LOG(Log::sceNet, "NxPspLink: registered");
+}
+
+void Unregister() {
+	if (!enabled) {
+		return;
+	}
+	// Under no lock of ours: the frontend joins its finder thread here, which may be in serve() or relogin().
+	// Still enabled meanwhile, so a server that thread starts skips the probe; the frontend's calls are safe
+	// throughout and answer "none" once it has let go of the core.
+	environment(NX_ENVIRONMENT_SET_PSP_LINK, nullptr);
+	enabled = false;
+	{
+		std::lock_guard<std::mutex> guard(serverMutex);
+		serveWanted = false;
+		StopServerLocked();
+	}
+	reported = 0;
+	{
+		std::lock_guard<std::mutex> guard(reportMutex);
+		sentActive = 0;
+		sentGrouped = 0;
+	}
+	reloginPending = false;
+	leavePending = false;
+	rejoinPending = false;
+	serverLost = false;
+	INFO_LOG(Log::sceNet, "NxPspLink: unregistered");
+}
+
+bool Server(uint32_t *ip, uint32_t *self) {
+	// Parked: the frontend's answer would be "none" after its whole listen window.
+	if (!enabled || parked) {
+		return false;
+	}
+	uint32_t serverIp = 0;
+	uint32_t selfAddr = 0;
+	if (!iface.server(&serverIp, &selfAddr)) {
+		return false;
+	}
+	selfIp = selfAddr;
+	*ip = serverIp;
+	*self = selfAddr;
+	return true;
+}
+
+void Active(bool active, bool grouped) {
+	if (!enabled) {
+		return;
+	}
+	const int state = !active ? 0 : grouped ? 2 : 1;
+	if (reported.exchange(state) == state) {
+		// The server's users may have changed meanwhile; told only if they did.
+		Report();
+		return;
+	}
+	bool back = false;
+	{
+		// The frontend sees the same changes and unparks on the same ones.
+		std::lock_guard<std::mutex> guard(parkMutex);
+		if (parked) {
+			if (!active) {
+				outSinceLeave = true;
+			} else if (outSinceLeave && route == ROUTE_AUTO) {
+				parked = false;
+				back = true;
+			}
+		}
+	}
+	if (back) {
+		INFO_LOG(Log::sceNet, "NxPspLink: back in ad hoc after a leave");
+	}
+	Report();
+}
+
+void Grouped(bool grouped) {
+	if (enabled && reported != 0) {
+		Active(true, grouped);
+	}
+}
+
+void ServerUsers(bool others) {
+	if (serverUsers.exchange(others) == others) {
+		return;
+	}
+	INFO_LOG(Log::sceNet, "NxPspLink: %s", others ? "another device is on this server" : "no other device on this server");
+	// Not once the server is stopping: whoever stops it holds serverMutex, which the frontend is never called under.
+	if (enabled && adhocServerRunning) {
+		Report();
+	}
+}
+
+bool InAdhoc() {
+	return enabled && reported != 0;
+}
+
+void RouteSocket(int fd) {
+	if (enabled && iface.route_socket) {
+		iface.route_socket(fd, 0);
+	}
+}
+
+uint32_t SelfIp() {
+	return selfIp;
+}
+
+bool TakeRelogin() {
+	return enabled && reloginPending.exchange(false);
+}
+
+int Presence() {
+	if (!enabled || parked) {
+		return PRESENCE_OUT;
+	}
+	switch (reported) {
+	case 0: return PRESENCE_OUT;
+	case 2: return PRESENCE_ROOM;
+	default: return PRESENCE_SEEKING;
+	}
+}
+
+bool Parked() {
+	return enabled && parked;
+}
+
+void SetRoute(Route r) {
+	route = r;
+}
+
+bool TakeLeave() {
+	return enabled && leavePending.exchange(false);
+}
+
+bool TakeRejoin() {
+	return enabled && rejoinPending.exchange(false);
+}
+
+void ServerLost() {
+	if (enabled) {
+		serverLost = true;
+	}
+}
+
+bool TakeServerLost() {
+	return enabled && serverLost.exchange(false);
+}
+
+void StopServer() {
+	std::lock_guard<std::mutex> guard(serverMutex);
+	StopServerLocked();
+}
+
+void ResetServer(void (*init)()) {
+	// One hold for the three steps: a serve(1) in between would start a server reading the tables init replaces.
+	std::lock_guard<std::mutex> guard(serverMutex);
+	StopServerLocked();
+	init();
+	if (enabled && serveWanted) {
+		StartServerLocked();
+	}
+}
+
+void ServerReady() {
+	std::lock_guard<std::mutex> guard(readyMutex);
+	serverReady = true;
+	readyCond.notify_all();
+}
+
+}  // namespace NxPspLink
+
+#if !PPSSPP_PLATFORM(WINDOWS)
+// A server whose device has gone without closing the connection would otherwise be noticed only when TCP gives up on
+// the unacknowledged pings, minutes later. The server is on the LAN, where an ack takes milliseconds.
+static const unsigned int SERVER_ACK_TIMEOUT_MS = 10000;
+
+extern "C" int NxPspLinkClientSocket(int domain, int type, int protocol) {
+	int fd = socket(domain, type, protocol);
+	if (fd >= 0 && NxPspLink::Enabled()) {
+		NxPspLink::RouteSocket(fd);
+#ifdef TCP_USER_TIMEOUT
+		if (type == SOCK_STREAM) {
+			unsigned int ms = SERVER_ACK_TIMEOUT_MS;
+			setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &ms, sizeof(ms));
+		}
+#endif
+	}
+	return fd;
+}
+#endif
