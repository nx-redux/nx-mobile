 				const int loadedState = adhocctlState;
+				NxPspLink::Active(false, false);
 				StopFriendFinder();
 				adhocctlState = loadedState;
-				NxPspLink::Active(false, false);
 			}
 			isAdhocctlNeedLogin = false;
 		}
@@ -3162,11 +3171,12 @@ int NetAdhocctl_Term() {
 				NetAdhocctl_Disconnect();
 		}
 
-		// Stop the adhocctl client
