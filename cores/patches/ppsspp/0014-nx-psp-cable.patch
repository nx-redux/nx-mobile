 			StartFriendFinder();
 		} else {
 			if (!netAdhocctlInited && cur_netAdhocctlInited) {
-				// The thread sets adhocctlState on its way out, so keep the loaded one.
+				// The thread sets adhocctlState on its way out, so keep the loaded one. The frontend is told first: a
