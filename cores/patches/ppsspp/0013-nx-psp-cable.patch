# PSP ad hoc over nx-mobile's phone-to-phone USB cable as well as the Wi-Fi (on top of 0012): the runner decides which
# network the link is on and routes every socket the core hands it there. The game's PDP sockets and PTP listen
# sockets outlive a group, so when the runner asks for a new login (as it does on every move between networks) and
# after each login they are routed again onto the link's network; a socket left on the old one would send where the
# new peers are not. While a phone is on
# the port and its cable is coming up, the runner holds its answer for the server up to 9 s; a game's Scan / Create /
# Connect / Join now waits for the login that long (and for the connect after it) instead of returning BUSY after
# 5 s, which some games take as a failure (Tekken 6 calls Connect on entering its lobby). Without a frontend that
# answers the call, the core behaves as upstream.
diff --git a/Core/HLE/NxPspLink.cpp b/Core/HLE/NxPspLink.cpp
index 04287d2..2f4c90e 100644
--- a/Core/HLE/NxPspLink.cpp
+++ b/Core/HLE/NxPspLink.cpp
@@ -304,6 +304,7 @@ bool InAdhoc() {
 
 void RouteSocket(int fd) {
 	if (enabled && iface.route_socket) {
+		// The frontend chooses the network (the Wi-Fi or the cable) from where the link is; the argument is unused.
 		iface.route_socket(fd, 0);
 	}
 }
diff --git a/Core/HLE/NxPspLink.h b/Core/HLE/NxPspLink.h
index 5387ad1..add9c9d 100644
--- a/Core/HLE/NxPspLink.h
+++ b/Core/HLE/NxPspLink.h
@@ -34,8 +34,13 @@ void Register(EnvironmentCallback environment);
 // Before the PSP shuts down. Also stops a server the frontend started.
 void Unregister();
 
-// The server to log in to and this device's address on its network, both network order. Blocks up to about
-// 1.5 s while the frontend listens for one, so only from the login thread. False: none this time.
+// The longest Server() blocks: while the frontend waits for a phone-to-phone cable that is coming, it holds the
+// answer through that wait and a listen window after it (nx_psp_link.h).
+const int SERVER_WAIT_MAX_MS = 9000;
+
+// The server to log in to and this device's address on its network (the Wi-Fi's or the cable's), both network order.
+// Blocks up to about 1.5 s while the frontend listens for one, up to SERVER_WAIT_MAX_MS while it waits for a cable,
+// so only from the login thread. False: none this time.
 bool Server(uint32_t *ip, uint32_t *self);
 // The game reached Scan / Create / Connect / Join, is in a group, or left ad hoc. What the frontend is told also
 // carries whether this device's server has another user (ServerUsers); only changes reach it.
@@ -43,6 +48,7 @@ void Active(bool active, bool grouped);
 // The poll's view of the group, reported while the game is in ad hoc.
 void Grouped(bool grouped);
 bool InAdhoc();
+// Every ad hoc socket, once made: the frontend puts it on the network the link is on.
 void RouteSocket(int fd);
 // The address last given by Server(); 0 before.
 uint32_t SelfIp();
diff --git a/Core/HLE/proAdhoc.cpp b/Core/HLE/proAdhoc.cpp
index 962c8a5..ff7b3db 100644
--- a/Core/HLE/proAdhoc.cpp
+++ b/Core/HLE/proAdhoc.cpp
@@ -1528,6 +1528,28 @@ static void StartAdhocctlLogin() {
 	adhocServerResolved = true;
 }
 
+// The link routes each socket onto its network when the socket is made. The game's PDP sockets and PTP listen sockets
+// outlive a group, so after the link moves to the other network (the Wi-Fi or the phone-to-phone cable) they are routed
+// again: a socket left on the old network sends its packets there, where the new peers aren't. Connected PTP sockets are
+// left alone; their peer was on the old network, and the game drops them with the group. The table is only changed on
+// this, the CPU thread.
+static void RouteAdhocSocketsForLink() {
+	if (!NxPspLink::Enabled() || serverHasRelay) {
+		return;
+	}
+	for (int i = 0; i < MAX_SOCKET; i++) {
+		const AdhocSocket *sock = adhocSockets[i];
+		if (sock == NULL) {
+			continue;
+		}
+		if (sock->type == SOCK_PDP) {
+			NxPspLink::RouteSocket(sock->data.pdp.id);
+		} else if (sock->type == SOCK_PTP && sock->data.ptp.state == ADHOC_PTP_STATE_LISTEN) {
+			NxPspLink::RouteSocket(sock->data.ptp.id);
+		}
+	}
+}
+
 static void FinishAdhocctlLogin() {
 	adhocctlLoginThread.join();
 	adhocctlLoginRunning = false;
@@ -1575,6 +1597,9 @@ static void FinishAdhocctlLogin() {
 
 	g_adhocServerConnected = true;
 	INFO_LOG(Log::sceNet, "FriendFinder: Network [RE]Initialized");
+	// Sockets the game made before this login went where the link was then, which may not be where this server is
+	// (the cable can come up before the first login, with nothing to log in again from).
+	RouteAdhocSocketsForLink();
 	if (!adhocctlLoggedIn) {
 		// The first login after sceNetAdhocctlInit. A request the game made meanwhile is waiting for it,
 		// and still busy.
@@ -1659,6 +1684,8 @@ void friendFinderPoll() {
 		}
 		// The group was on the old server.
 		NetAdhocctl_ServerLost();
+		// The new server can be on the other network.
+		RouteAdhocSocketsForLink();
 		// A game that has only inited stays off the network until its own Scan, Create, Connect or Join.
 		if (NxPspLink::InAdhoc() && !NxPspLink::Parked()) {
 			isAdhocctlNeedLogin = true;
diff --git a/Core/HLE/sceNetAdhoc.cpp b/Core/HLE/sceNetAdhoc.cpp
index 040bcf2..00972b8 100644
--- a/Core/HLE/sceNetAdhoc.cpp
+++ b/Core/HLE/sceNetAdhoc.cpp
@@ -133,6 +133,12 @@ static int PspEventDelayUs(u32 flags) {
 // The request goes out to the server then, and the call returns once it's sent.
 static const int ADHOCCTL_REQUEST_US = 30;
 
+// With the nx-mobile link a request waits for the login it set off as long as that login can take: Server()'s longest
+// wait, the connect to the server (which aemu_postoffice gives up after 5 s), and a second for the poll to collect it.
+// Cut short, the request would return BUSY, which some games take as a failure (Tekken 6 entering its lobby throws the
+// player out); a login that fails tells the waiting game itself (FinishAdhocctlLogin).
+static const u64 LINK_REQUEST_TIMEOUT_US = (NxPspLink::SERVER_WAIT_MAX_MS + 5000 + 1000) * 1000ULL;
+
 static int RemainingEventDelayUs(u32 flags) {
 	s64 left = (s64)(adhocctlRequestTimeUs + PspEventDelayUs(flags)) - (s64)CoreTiming::GetGlobalTimeUs();
 	return left > 0 ? (int)left : 0;
@@ -673,7 +679,8 @@ static void __AdhocctlNotify(u64 userdata, int cyclesLate) {
 		if (call_status == ADHOCCTL_CALL_WOULDBLOCK) {
 			bool retry = true;
 			u64 now = CoreTiming::GetGlobalTimeUs();
-			if (now - adhocctlStartTime > static_cast<u64>(adhocDefaultTimeout) + 500) {
+			const u64 timeout = NxPspLink::Enabled() ? LINK_REQUEST_TIMEOUT_US : static_cast<u64>(adhocDefaultTimeout);
+			if (now - adhocctlStartTime > timeout + 500) {
 				retry = false;
 			}
 
diff --git a/libretro/nx_psp_link.h b/libretro/nx_psp_link.h
index c395060..ff4d6f2 100644
--- a/libretro/nx_psp_link.h
+++ b/libretro/nx_psp_link.h
@@ -1,5 +1,5 @@
 #pragma once
-// nx-mobile private libretro environment call: PSP ad hoc over Wi-Fi. The core hands the frontend its ad hoc link, so
+// nx-mobile private libretro environment call: PSP ad hoc over Wi-Fi or the phone-to-phone cable. The core hands the frontend its ad hoc link, so
 // the frontend can follow it and leave it as it does Azahar's room (nx_3ds_link.h), and tells the core which device runs
 // the ad hoc server: the frontend runs the finder and the election (psl_finder.h), the core runs the server and the
 // client. *data is a nx_psp_link_interface* whose frontend half the frontend fills in, or NULL when the link is gone and
@@ -17,12 +17,16 @@ struct nx_psp_link_interface {
     void (*serve)(int on);    /* start or stop the built-in ad hoc server; returns once it listens or has stopped */
     void (*relogin)(void);    /* the server changed or is gone: drop its connection, tell the game if it was in a group */
     /* The frontend's, filled in while it answers the call. */
-    int  (*server)(uint32_t* ip, uint32_t* self);  /* blocks up to PSL_LISTEN_MS + 500; 1: *ip is the server, *self this
-                                                      device's address on the routed network (network order); 0: none */
+    /* Blocks up to 1.5 s (PSL_LISTEN_MS + 500), and up to 9 s while the election waits for a cable that is coming.
+     * 1: *ip is the server, *self this device's address on the network the server is on (the Wi-Fi's or the cable's;
+     * network order); 0: none. */
+    int  (*server)(uint32_t* ip, uint32_t* self);
     /* active: the game reached Scan/Create/Connect/Join, 0 once it left ad hoc. grouped: the game is in a group, or
      * this device's server has a user other than this device, so the server must not stop; it can stay 1 with active
      * 0 while others play on the server of a game that left ad hoc. Only changes are told, from any thread. */
     void (*active)(int active, int grouped);
+    /* Every socket of the link's, once made: the frontend routes it onto the network the link is on (the one of the
+     * server server() last answered, or is about to), so the second argument is ignored. Any thread. */
     void (*route_socket)(int fd, int cable);
 };
 /* *data NULL: the core's link is gone; make no further calls. */
