diff --git a/src/drivers/libretro/libretro.c b/src/drivers/libretro/libretro.c
index 55cf607..fcacaa0 100644
--- a/src/drivers/libretro/libretro.c
+++ b/src/drivers/libretro/libretro.c
@@ -2084,8 +2084,13 @@ void retro_deinit (void)
    stereo_filter_deinit();
 }
 
+/* NX Redux: frames left until a one-press disk flip inserts the next side (0: none pending) */
+#define FDS_FLIP_FRAMES 60
+static int fds_flip_wait = 0;
+
 void retro_reset(void)
 {
+   fds_flip_wait = 0;
    /* Reset clears the turbo toggle phase so the rapid-fire cycle starts
     * at the same point every reset, matching how the core's other
     * input-poll state behaves on power-cycle.  Without this, a held
@@ -3154,13 +3159,40 @@ static void FCEUD_UpdateInput(void)
       bool curR = input_cb(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_R);
       static bool prevL = false, prevR = false;
 
-      if (curL && !prevL)
-         FCEU_FDSSelect();          /* Swap FDisk side */
+      /* NX Redux: L with a disk in turns it over in one press: eject now,
+       * then select the next side and insert it FDS_FLIP_FRAMES later, so
+       * the game sees the drive go empty as on the real drive. With the
+       * drive empty (R, a state saved mid-flip, a reset) L puts the next
+       * side in at once, so L alone always ends with a disk in; L while a
+       * flip is pending is ignored; R cancels a pending flip, then acts as
+       * before. */
+      if (curL && !prevL && fds_flip_wait == 0)
+      {
+         if (FCEU_FDSInserted())
+         {
+            FCEU_FDSInsert(-1);     /* eject */
+            fds_flip_wait = FDS_FLIP_FRAMES;
+         }
+         else
+         {
+            FCEU_FDSSelect();       /* Swap FDisk side */
+            FCEU_FDSInsert(-1);     /* and insert it */
+         }
+      }
       prevL = curL;
 
       if (curR && !prevR)
+      {
+         fds_flip_wait = 0;
          FCEU_FDSInsert(-1);        /* Insert or eject the disk */
+      }
       prevR = curR;
+
+      if (fds_flip_wait > 0 && --fds_flip_wait == 0)
+      {
+         FCEU_FDSSelect();
+         FCEU_FDSInsert(-1);        /* insert the next side */
+      }
    }
 
    /* Handle internal palette switching */
@@ -3454,6 +3486,9 @@ bool retro_serialize(void *data, size_t size)
 
 bool retro_unserialize(const void * data, size_t size)
 {
+   /* NX Redux: a pending disk flip belongs to the state left behind */
+   fds_flip_wait = 0;
+
    /* Cannot load state while Game Genie
     * screen is open */
    if (geniestage == 1)
@@ -4364,6 +4399,7 @@ bool retro_load_game_special(
 
 void retro_unload_game(void)
 {
+   fds_flip_wait = 0;
 #ifdef HAVE_HDPACK
    HDNes_Unload();
    if (hd_patched_rom)
