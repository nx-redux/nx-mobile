+// nx-mobile: a code not in the game INIs (the player's own .cht); "ar:" marks Action Replay, else Gecko.
+static bool add_cheat_code(const char* code)
+{
+  std::string text(code ? code : "");
+  const bool is_ar = text.rfind("ar:", 0) == 0;
+  if (is_ar)
+    text.erase(0, 3);
+
+  std::vector<std::pair<u32, u32>> ops;
+  std::vector<std::string> lines;
+  size_t start = 0;
+  while (start <= text.size())
+  {
+    size_t end = text.find('+', start);
+    if (end == std::string::npos)
+      end = text.size();
+    const std::string part = text.substr(start, end - start);
+    // Exactly two 8-digit hex words separated by spaces ("0x", signs and short tokens are rejected).
+    const auto is_word = [](const std::string& w) {
+      return w.size() == 8 && w.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos;
+    };
+    const size_t gap = part.find(' ');
+    const size_t second = gap == std::string::npos ? gap : part.find_first_not_of(' ', gap);
+    if (second == std::string::npos || !is_word(part.substr(0, gap)) || !is_word(part.substr(second)))
+    {
+      WARN_LOG_FMT(ACTIONREPLAY, "nx-mobile: ignoring malformed cheat code '{}'", part);
+      return false;
+    }
+    const u32 a = static_cast<u32>(std::stoul(part.substr(0, gap), nullptr, 16));
+    const u32 v = static_cast<u32>(std::stoul(part.substr(second), nullptr, 16));
+    ops.emplace_back(a, v);
+    lines.push_back(part);
+    start = end + 1;
+  }
+
+  if (is_ar)
+  {
+    ActionReplay::ARCode ar;
+    ar.name = "nx-mobile code";
+    for (const auto& [a, v] : ops)
+      ar.ops.emplace_back(a, v);
+    ar.enabled = true;
+    ar.user_defined = true;
+    Libretro::g_ar_codes.push_back(std::move(ar));
+  }
+  else
+  {
+    Gecko::GeckoCode gecko;
+    gecko.name = "nx-mobile code";
+    for (size_t i = 0; i < ops.size(); ++i)
+      gecko.codes.push_back({ops[i].first, ops[i].second, lines[i]});
+    gecko.enabled = true;
+    gecko.user_defined = true;
+    Libretro::g_gecko_codes.push_back(std::move(gecko));
+  }
+  return true;
 }
 
