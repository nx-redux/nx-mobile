diff --git a/Source/Core/DolphinLibretro/NxDisc.cpp b/Source/Core/DolphinLibretro/NxDisc.cpp
new file mode 100644
index 0000000000..5a810c5867
--- /dev/null
+++ b/Source/Core/DolphinLibretro/NxDisc.cpp
@@ -0,0 +1,57 @@
+// nx-mobile 2026-10-13: the raw disc behind any image Dolphin opens (ISO, GCM, WBFS, CISO, GCZ, WIA, RVZ), for the
+// frontend's RetroAchievements hashing (rcheevos hashes the raw disc). No emulator state is touched.
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include <unistd.h>
+
+#include "Common/DirectIOFile.h"
+#include "DiscIO/Blob.h"
+
+#define NX_DISC_EXPORT extern "C" __attribute__((visibility("default"), used))
+
+NX_DISC_EXPORT void* nx_disc_open(const char* path)
+{
+  if (!path)
+    return nullptr;
+  std::unique_ptr<DiscIO::BlobReader> r = DiscIO::CreateBlobReader(std::string(path));
+  return r.release();
+}
+
+// The frontend's SAF descriptor, read through a dup (the caller keeps and closes its own). The app holds no storage
+// permission, so reopening it by name (/proc/self/fd/N) can be refused. A split WBFS's other parts are not found.
+NX_DISC_EXPORT void* nx_disc_open_fd(int fd)
+{
+  if (fd < 0)
+    return nullptr;
+  const int own = dup(fd);
+  if (own < 0)
+    return nullptr;
+  std::unique_ptr<DiscIO::BlobReader> r =
+      DiscIO::CreateBlobReader(File::DirectIOFile::FromFd(own), std::string());
+  return r.release();
+}
+
+NX_DISC_EXPORT int64_t nx_disc_size(void* h)
+{
+  return h ? static_cast<int64_t>(static_cast<DiscIO::BlobReader*>(h)->GetDataSize()) : -1;
+}
+
+NX_DISC_EXPORT int64_t nx_disc_read(void* h, uint64_t offset, void* buf, int64_t len)
+{
+  if (!h || !buf || len < 0)
+    return -1;
+  auto* r = static_cast<DiscIO::BlobReader*>(h);
+  const uint64_t size = r->GetDataSize();
+  if (offset >= size || len == 0)
+    return 0;
+  const uint64_t n = std::min<uint64_t>(static_cast<uint64_t>(len), size - offset);
+  return r->Read(offset, n, static_cast<uint8_t*>(buf)) ? static_cast<int64_t>(n) : -1;
+}
+
+NX_DISC_EXPORT void nx_disc_close(void* h)
+{
+  delete static_cast<DiscIO::BlobReader*>(h);
+}
