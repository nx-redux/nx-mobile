+#if defined(HAVE_DYNAREC) && defined(MMAP_JIT_CACHE)
+/* nx-mobile: the recompiler cache must sit within +/-128 MB of the core's
+ * code, and a busy address space may have no such gap. The frontend keeps
+ * this .so loaded between games, so the block is mapped once, on the first
+ * retro_init, and reused by every later session. retro_deinit leaves it
+ * mapped; it is released only if the library itself is unloaded. */
+static u8 *nx_jit_block = NULL;
+
+__attribute__((destructor)) static void nx_unmap_jit_block(void)
+{
+   if (nx_jit_block)
+      unmap_jit_block(nx_jit_block, ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
+   nx_jit_block = NULL;
+}
+#endif
+
+/* nx-mobile: a second retro_init on the same loaded .so must start where a
+ * freshly loaded one does. Resets the state that nothing else in the init,
+ * load or reset path sets again (it was only reset by the frontend unloading
+ * the library between games). */
+static int sound_rate_configured = 0;
+
+static void nx_reset_session_state(void)
+{
+   cheat_clear();
+   input_reset_session();
+   memory_reset_session();
+   serial_set_irq_cycles(0);
+   serialproto_reset();
+
+   memset(palette_ram_converted, 0, sizeof(palette_ram_converted));
+   memset(affine_reference_x, 0, sizeof(affine_reference_x));
+   memset(affine_reference_y, 0, sizeof(affine_reference_y));
+
+   skip_next_frame   = 0;
+   sprite_limit      = 1;
+   rtc_mode          = FEAT_AUTODETECT;
+   rumble_mode       = FEAT_AUTODETECT;
+   serial_setting    = SERIAL_MODE_AUTO;
+   rumble_cb         = NULL;
+   main_path[0]      = '\0';
+   /* the next load applies gpsp_sound_rate as a load-time pick again */
+   sound_rate_configured = 0;
+}
