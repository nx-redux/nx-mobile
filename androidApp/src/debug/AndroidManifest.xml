<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the adb test hooks (NxTestReceiver, or NxTestActivity where broadcasts are dropped), exported so adb reaches them; and
     cleartext to localhost, for testing the updater against a local feed (-PnxUpdateFeed). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <receiver
            android:name="com.nxredux.mobile.test.NxTestReceiver"
            android:exported="true" />
        <!-- GAME_STOP's second half: the game runs in the game process. -->
        <receiver
            android:name="com.nxredux.mobile.test.NxGameStopReceiver"
            android:process=":game"
            android:exported="false" />
        <!-- The same hooks as activity starts, for devices that drop adb broadcasts (NxTestActivity). -->
        <activity
            android:name="com.nxredux.mobile.test.NxTestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- In the game's task: a start in the menu's task would bring the menu forward and stop the game it quits. -->
        <activity
            android:name="com.nxredux.mobile.test.NxGameStopActivity"
            android:process=":game"
            android:taskAffinity="${applicationId}.game"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
