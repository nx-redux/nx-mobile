<resources>
    <style name="Theme.NxMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- GameActivity's: no starting window. The game starts its own process, so Android would otherwise show the app's
         splash (the icon) between the menu's launch name and the game screen's hold of the same name; without it the
         menu stays up until the hold's first frame lands on the same pixels. -->
    <style name="Theme.NxMobile.Game">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- MainActivity's launch theme; installSplashScreen() swaps to postSplashScreenTheme. -->
    <style name="Theme.NxMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.NxMobile</item>
    </style>
</resources>
